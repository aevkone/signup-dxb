---
import Base from '@/layouts/Base.astro';
import { link } from '@/i18n';
---

<Base title="404">
  <section class="section">
    <div class="shell">
      <p class="eyebrow">404</p>
      <h1 class="h1" style="margin-top:16px">Такой страницы нет</h1>
      <p class="lead measure" style="margin-top:12px" lang="en">Page not found</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:32px">
        <a class="btn btn--primary" href={link('/')}>На главную</a>
        <a class="btn btn--ghost" href={link('/', 'en')} lang="en">Home page</a>
      </div>
    </div>
  </section>
</Base>
