---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { getLang } from '@/i18n';
import { CONTACTS, SITE_NAME, local } from '@/consts';

const lang = getLang(Astro.url);
const L = local(lang);
const T = {
  ru: {
    title: 'Политика обработки данных',
    crumb: 'Политика данных',
    description: `Какие данные ${SITE_NAME} получает из формы заявки, зачем они нужны, сколько хранятся и как их удалить. Оператор данных — ${L.legalName}.`,
    blocks: [
      ['', `Оператор данных — ${L.legalName}, лицензия ${L.licence}, ${L.address}.`],
      [
        'Какие данные мы получаем',
        'Только то, что вы сами указываете в форме заявки или в расчёте стоимости: имя, контакт для связи (телефон, WhatsApp или email), описание задачи и параметры выбранной услуги. По желанию можно приложить макет — файл до 10 МБ.',
      ],
      [
        'Как заявка доходит до нас',
        `Форма отправляет заявку через серверную функцию сайта на Cloudflare Pages. Оттуда она приходит нам в Telegram и на почту ${CONTACTS.email}; отдельной базы заявок у сайта нет. Если сервер недоступен, сайт предложит отправить ту же заявку через WhatsApp — сообщение уйдёт, только когда вы сами нажмёте «Отправить» в WhatsApp.`,
      ],
      [
        'Зачем',
        'Только чтобы ответить вам и подготовить расчёт или предложение. Данные не используются для рассылок и не передаются третьим лицам для рекламы.',
      ],
      [
        'Сколько храним',
        'Храним заявки не дольше, чем нужно для работы над запросом и требований закона.',
      ],
      [
        'Как удалить данные',
        `Напишите на ${CONTACTS.email} — удалим вашу заявку и переписку по ней.`,
      ],
    ],
  },
  en: {
    title: 'Privacy policy',
    crumb: 'Privacy policy',
    description: `What data ${SITE_NAME} receives from the request form, why, how long it is kept and how to delete it. Data controller — ${L.legalName}.`,
    blocks: [
      ['', `Data controller — ${L.legalName}, licence ${L.licence}, ${L.address}.`],
      [
        'What data we receive',
        'Only what you enter yourself in the request form or the cost configurator: your name, a way to reach you (phone, WhatsApp or email), a description of your request and the details of the service you chose. You can also attach a design file of up to 10 MB if you wish.',
      ],
      [
        'How your request reaches us',
        `The form sends your request through the website’s server function on Cloudflare Pages, which delivers it to our Telegram and to ${CONTACTS.email}; the website keeps no separate database of requests. If the server is unavailable, the site offers to send the same request via WhatsApp — the message goes only when you tap Send in WhatsApp yourself.`,
      ],
      [
        'Why',
        'Only to reply to you and prepare a quote or proposal. The data is not used for mailings and is not shared with third parties for advertising.',
      ],
      [
        'How long we keep it',
        'We keep requests no longer than needed to work on your enquiry and to meet legal requirements.',
      ],
      [
        'How to delete your data',
        `Write to ${CONTACTS.email} and we’ll delete your request and the related correspondence.`,
      ],
    ],
  },
}[lang];
---

<Base title={T.title} description={T.description} crumbs={[{ label: T.crumb }]}>
  <PageHero title={T.title} crumbs={[{ label: T.crumb }]} />
  <section class="section--tight" style="padding-top:0">
    <div class="shell prose measure">
      {
        T.blocks.map(([h, p]) => (
          <>
            {h && <h2 class="h3">{h}</h2>}
            <p>{p}</p>
          </>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .prose {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .prose h2 {
    margin-top: 18px;
  }
</style>
