---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import LeadForm from '@/components/LeadForm.astro';
import { getLang, link } from '@/i18n';
import { ui } from '@/i18n/ui';
import { blocks } from '@/data/exhibitions';
import { standRate, fmtMoney } from '@/data/production';
import { waLink } from '@/consts';

interface Props {
  slug: string;
}
const lang = getLang(Astro.url);
const u = ui(lang);
const BLOCKS = blocks(lang);
const index = BLOCKS.findIndex((b) => b.slug === Astro.props.slug);
const block = BLOCKS[index]!;
const others = BLOCKS.filter((b) => b.slug !== block.slug);
const T = {
  ru: {
    parent: 'Выставки под ключ',
    quote: 'Рассчитать стоимость',
    anchor: (from: string) => `Стенд под ключ — ориентир ${from}/м²`,
    anchorLink: 'примеры в прайсе',
    of: (i: number, n: number) => `Блок ${i} из ${n} · можно заказать отдельно`,
    incl: 'Что входит',
    know: 'Что важно знать',
    others: 'Другие блоки',
    all: 'Весь состав',
  },
  en: {
    parent: 'Turnkey exhibitions',
    quote: 'Get a quote',
    anchor: (from: string) => `Turnkey stand — guide price ${from}/m²`,
    anchorLink: 'examples in the price list',
    of: (i: number, n: number) => `Block ${i} of ${n} · can be ordered separately`,
    incl: 'What’s included',
    know: 'Good to know',
    others: 'Other blocks',
    all: 'Full scope',
  },
}[lang];

/** Заголовки для поисковиков — с городом. Нет в списке — название блока + город. */
const META_TITLE: Record<typeof lang, Record<string, string>> = {
  ru: {
    'stand-design': 'Дизайн и застройка выставочных стендов в Дубае',
    print: 'Печать и сувениры для выставки в Дубае',
    staff: 'Персонал на выставочный стенд в Дубае',
    catering: 'Кейтеринг на выставочный стенд в Дубае',
    logistics: 'Выставочная логистика в Дубае',
    concierge: 'Консьерж-сервис для участников выставок в Дубае',
    payment: 'Помощь в оплате участия в выставке в Дубае',
    negotiations: 'Переговоры с организаторами выставок в Дубае',
  },
  en: {
    'stand-design': 'Exhibition stand design & build in Dubai',
    print: 'Exhibition print & merchandise in Dubai',
    staff: 'Exhibition stand staff in Dubai',
    catering: 'Exhibition stand catering in Dubai',
    logistics: 'Exhibition logistics in Dubai',
    concierge: 'Concierge for exhibitors in Dubai',
    payment: 'Help paying for exhibition participation in Dubai',
    negotiations: 'Negotiations with exhibition organisers in Dubai',
  },
};
/** Ориентир за м² — только у блока про стенд; цифра из прайса (группа expo). */
const rate = block.slug === 'stand-design' ? standRate(lang) : null;

const metaTitle = META_TITLE[lang][block.slug] ?? `${block.title} ${lang === 'en' ? 'in Dubai' : 'в Дубае'}`;

/**
 * Описание для поисковиков — до ~160 знаков: «Название. Лид», если влезает;
 * иначе только лид, а длинный лид — по целым предложениям.
 */
const metaDescription = (() => {
  const full = `${block.title}. ${block.lead}`;
  if (full.length <= 160 || block.lead.length <= 160) return full.length <= 160 ? full : block.lead;
  const sentences = block.lead.split(/(?<=[.!?])\s+/);
  let out = sentences[0]!;
  for (const x of sentences.slice(1)) {
    if (`${out} ${x}`.length > 160) break;
    out = `${out} ${x}`;
  }
  return out;
})();
---

<Base
  title={metaTitle}
  description={metaDescription}
  crumbs={[{ href: '/exhibitions/', label: T.parent }, { label: block.title }]}
>
  <PageHero title={block.title} lead={block.lead} crumbs={[{ href: '/exhibitions/', label: T.parent }, { label: block.title }]}>
    {
      rate && (
        <p class="anchor">
          {T.anchor(fmtMoney(rate.lo, null, lang))} · <a href={link('/prices/#expo', lang)}>{T.anchorLink}</a>
        </p>
      )
    }
    {/* Одна просьба на странице: кнопка ведёт к форме внизу, где уже подставлен этот блок. */}
    <div class="hero-actions">
      <a class="btn btn--primary" href="#lead">{T.quote}</a>
      <a class="btn btn--ghost" href={waLink(lang, block.title)} target="_blank" rel="noopener">
        <Icon name="whatsapp" size={20} /> {u.whatsapp}
      </a>
      <span class="caption">{T.of(index + 1, BLOCKS.length)}</span>
    </div>
  </PageHero>

  <section class="section section--surface">
    <div class="shell">
      <h2 class="h2">{T.incl}</h2>
      <div class="grid grid--2 inc">
        {
          block.includes.map((x, i) => (
            <div class="inc__item">
              <span class="inc__n">{i + 1}</span>
              <div>
                <h3 class="h3">{x.title}</h3>
                <p>{x.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell split">
      <div>
        <h2 class="h2">{T.know}</h2>
        <ul class="points">
          {
            block.points.map((p) => (
              <li>
                <Icon name="check" size={20} />
                {p}
              </li>
            ))
          }
        </ul>
      </div>
      {
        block.note && (
          <aside class="note">
            <span class="eyebrow">{block.note.title}</span>
            <p>{block.note.text}</p>
          </aside>
        )
      }
    </div>
  </section>

  <section class="section section--surface">
    <div class="shell">
      <div class="sec-head">
        <h2 class="h2">{T.others}</h2>
        <a class="btn btn--ghost" href={link('/exhibitions/', lang)}>{T.all}</a>
      </div>
      {/* Компактные ссылки-пилюли: на телефоне семь карточек занимали больше тысячи пикселей. */}
      <div class="others">
        {
          others.map((b) => (
            <a class="other" href={link(`/exhibitions/${b.slug}/`, lang)}>
              <Icon name={b.icon} size={20} />
              {b.title}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="lead">
    <div class="shell">
      <LeadForm context={`${u.interested}: ${block.title}`} />
    </div>
  </section>
</Base>
<style>
  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 16px;
    margin-top: 30px;
  }
  .inc {
    margin-top: 36px;
    gap: 36px 48px;
  }
  .inc__item {
    display: flex;
    gap: 18px;
  }
  .inc__n {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    border-radius: 50%;
    border: 1px solid var(--line);
    display: grid;
    place-items: center;
    font-size: 14px;
    font-weight: 700;
    color: var(--accent);
  }
  .inc__item p {
    margin-top: 8px;
    color: #4a4e55;
  }
  .split {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 64px;
    align-items: start;
  }
  .points {
    margin-top: 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .points li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .points :global(svg) {
    flex-shrink: 0;
    margin-top: 4px;
    color: var(--ok);
  }
  .note {
    background: var(--ink);
    color: #fff;
    border-radius: var(--radius);
    padding: 36px;
  }
  .note .eyebrow {
    color: #8b8f96;
  }
  .note p {
    margin-top: 16px;
    font-size: 20px;
    line-height: 31px;
    font-weight: 600;
  }
  .anchor {
    margin-top: 18px;
    color: var(--on-stage);
    font-size: 16px;
    line-height: 24px;
  }
  .anchor a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .others {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .other {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 8px 18px;
    border: 1px solid var(--line);
    border-radius: var(--pill);
    background: var(--surface);
    color: var(--ink);
    font-size: 15px;
    font-weight: 600;
    line-height: 20px;
  }
  .other:hover {
    border-color: var(--ink);
    color: var(--ink);
  }
  .other :global(svg) {
    flex: none;
    color: var(--accent);
  }
  @media (max-width: 860px) {
    .split {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .note {
      padding: 26px;
    }
  }
</style>
