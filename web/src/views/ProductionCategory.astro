---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import LeadForm from '@/components/LeadForm.astro';
import Works from '@/components/Works.astro';
import { worksFor, workTitle } from '@/data/works';
import { getLang, link } from '@/i18n';
import { ui } from '@/i18n/ui';
import { categories, itemPrice } from '@/data/production';
import { local, waLink } from '@/consts';

interface Props {
  slug: string;
}
const lang = getLang(Astro.url);
const u = ui(lang);
const L = local(lang);
const CATS = categories(lang);
const c = CATS.find((x) => x.slug === Astro.props.slug)!;
const others = CATS.filter((x) => x.slug !== c.slug);
/** Снимки категории: до трёх — в шапке, следующие шесть — в «Примерах работ», без повторов. */
const WORKS = worksFor(c.slug);
const HERO_WORKS = WORKS.slice(0, 3);
const img = (id: string, w: number, ext = 'webp') => link(`/img/works/w${id}-${w}.${ext}`);
/** Сколько пунктов «+» видно в карточке на телефоне, остальные — под «ещё N». */
const PLUS_SHOWN = 3;
/** Первая буква строчная — для вставки в середину фразы («3D» не трогаем). */
const lower = (s: string) => (/^[A-ZА-ЯЁ][a-zа-яё]/.test(s) ? s[0]!.toLowerCase() + s.slice(1) : s);
const T = {
  ru: {
    crumb: 'Наружная реклама',
    metaTitle: `${c.title} в Дубае`,
    description: `${c.title} в Дубае, Шардже и Аджмане: ${lower(c.short)}. Работаем напрямую с производством, минимальный заказ ${L.minOrder}.`,
    quote: 'Рассчитать стоимость',
    adv: 'Преимущества',
    offer: 'Мы предлагаем',
    terms: `Ориентировочные цены — в прайсе. Минимальный заказ ${L.minOrder}. Замер ${L.survey} — засчитывается в стоимость.`,
    pricesLink: 'Открыть прайс',
    works: 'Примеры работ',
    worksAll: 'Все работы',
    order: 'Рассчитать',
    leadTitle: `Расчёт стоимости: ${c.title.toLowerCase()}`,
    guide: 'ориентир, без VAT',
    more: (n: number) => `ещё ${n}`,
    less: 'свернуть',
    others: 'Другие направления',
  },
  en: {
    crumb: 'Outdoor advertising',
    metaTitle: `${c.title} in Dubai`,
    description: `${c.title} in Dubai, Sharjah and Ajman: ${lower(c.short)}. We work directly with production, minimum order ${L.minOrder}.`,
    quote: 'Get a quote',
    adv: 'Advantages',
    offer: 'What we offer',
    terms: `Indicative prices are in the price list. Minimum order ${L.minOrder}. Site survey ${L.survey} — credited towards your order.`,
    pricesLink: 'Open the price list',
    works: 'Examples of our work',
    worksAll: 'All work',
    order: 'Get a price',
    leadTitle: `Get a quote: ${c.title.toLowerCase()}`,
    guide: 'guide price, excl. VAT',
    more: (n: number) => `${n} more`,
    less: 'show less',
    others: 'Other directions',
  },
}[lang];
---

<Base title={T.metaTitle} description={T.description} crumbs={[{ href: '/production/', label: T.crumb }, { label: c.title }]}>
  <PageHero title={c.title} lead={c.lead} crumbs={[{ href: '/production/', label: T.crumb }, { label: c.title }]}>
    <div class="hero-actions">
      <a class="btn btn--primary" href="#lead">{T.quote}</a>
      <a class="btn btn--ghost" href={waLink(lang, c.title)} target="_blank" rel="noopener">
        <Icon name="whatsapp" size={20} /> {u.whatsapp}
      </a>
    </div>
    {
      HERO_WORKS.length > 0 && (
        <ul class="cphotos">
          {HERO_WORKS.map((w, i) => (
            <li class:list={['cframe', i === 0 && 'taped']}>
              <picture>
                <source type="image/webp" srcset={`${img(w.id, 600)} 600w, ${img(w.id, 1200)} 1200w`} sizes="(max-width: 560px) 45vw, 260px" />
                <img src={img(w.id, 600, 'jpg')} width="600" height="600" alt={workTitle(w, lang)} loading="eager" decoding="async" />
              </picture>
              <p class="cframe__cap">{workTitle(w, lang)}</p>
            </li>
          ))}
        </ul>
      )
    }
  </PageHero>

  <section class="section section--surface">
    <div class="shell">
      <h2 class="h2">{T.adv}</h2>
      <div class="grid grid--4 adv">
        {
          c.advantages.map((a) => (
            <div class="adv__item">
              <h3 class="adv__t">{a.title}</h3>
              <p>{a.text}</p>
            </div>
          ))
        }
      </div>
      {c.materials && <p class="materials measure">{c.materials}</p>}
    </div>
  </section>

  {
    c.items.length > 0 && (
      <section class="section">
        <div class="shell">
          <div class="sec-head">
            <div>
              <h2 class="h2">{T.offer}</h2>
              <p class="sec-head__sub">{T.terms} <a href={link('/prices/', lang)}>{T.pricesLink}</a></p>
            </div>
          </div>
          <div class="grid grid--3 items">
            {c.items.map((it, i) => {
              /* Цена — только из строки прайса, привязанной к карточке; нет строки — нет цены. */
              const price = itemPrice(lang, c.slug, i);
              const hidden = it.plus.length - PLUS_SHOWN;
              return (
                <article class="card card--edge item">
                  <h3 class="item__t">{it.title}</h3>
                  <p class="item__text">{it.text}</p>
                  <p class="item__use caption">{it.use}</p>
                  <ul class="plus" id={`plus-${i}`}>
                    {it.plus.map((p, k) => (
                      <li class:list={[k >= PLUS_SHOWN && 'is-extra']}>{p}</li>
                    ))}
                  </ul>
                  {hidden > 0 && (
                    <button
                      type="button"
                      class="plus__more"
                      data-plus-more
                      aria-expanded="false"
                      aria-controls={`plus-${i}`}
                      data-more={T.more(hidden)}
                      data-less={T.less}
                    >
                      {T.more(hidden)}
                    </button>
                  )}
                  <div class="item__foot">
                    {price && (
                      <p class="item__price">
                        <strong>{price.money}</strong> {price.unit}
                        <span class="caption">{T.guide}</span>
                      </p>
                    )}
                    <a class="btn btn--order" href="#lead" data-order={`${u.interested}: ${c.title} — ${it.title}`}>
                      {T.order}
                    </a>
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      </section>
    )
  }

  {/* На телефоне примеры — горизонтальная лента с прокруткой, а не столбик из шести фото. */}
  <div class="pc-works">
    <Works title={T.works} list={WORKS.slice(3, 9)} more={{ href: '/works/', label: T.worksAll }} />
  </div>

  {
    c.uae && (
      <section class="section--tight">
        <div class="shell">
          <aside class="uae">
            <span class="eyebrow">{c.uae.title}</span>
            <p>{c.uae.text}</p>
          </aside>
        </div>
      </section>
    )
  }

  <section class="section section--surface" id="lead">
    <div class="shell">
      <LeadForm title={T.leadTitle} context={`${u.interested}: ${c.title}`} />
    </div>
  </section>

  <section class="section--tight">
    <div class="shell">
      <h2 class="h3 others-h">{T.others}</h2>
      <div class="others">
        {
          others.map((x) => (
            <a class="other" href={link(`/production/${x.slug}/`, lang)}>
              <Icon name={x.icon} size={20} />
              {x.title}
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<script>
  // «ещё N» раскрывает остальные пункты карточки (кнопка видна только на телефоне).
  document.querySelectorAll<HTMLButtonElement>('[data-plus-more]').forEach((b) => {
    b.addEventListener('click', () => {
      const open = b.getAttribute('aria-expanded') !== 'true';
      b.setAttribute('aria-expanded', String(open));
      b.textContent = (open ? b.dataset.less : b.dataset.more) ?? '';
      b.closest('.item')?.classList.toggle('is-open', open);
    });
  });

  // «Рассчитать» в карточке подставляет позицию в поле задачи формы.
  document.querySelectorAll<HTMLAnchorElement>('[data-order]').forEach((a) => {
    a.addEventListener('click', () => {
      const task = document.querySelector<HTMLTextAreaElement>('#lead textarea[name="task"]');
      if (task) task.value = a.dataset.order ?? '';
      setTimeout(() => document.querySelector<HTMLInputElement>('#lead input[name="name"]')?.focus(), 450);
    });
  });
</script>
<style>
  .hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 30px;
  }
  /* Снимки категории в шапке — фото в бумажных рамках на сцене, первое на скотче. */
  .cphotos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 260px));
    gap: 36px;
    margin-top: 52px;
    padding-inline: 6px;
  }
  .cframe {
    padding: 10px 10px 0;
    background: var(--surface);
    box-shadow: 0 30px 60px rgb(0 0 0 / 0.45);
    rotate: -3deg;
  }
  .cframe:nth-child(2) {
    rotate: 2.5deg;
    translate: 0 10px;
  }
  .cframe:nth-child(3) {
    rotate: -1.5deg;
  }
  .cframe picture {
    display: block;
  }
  .cframe img {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }
  .cframe__cap {
    padding: 10px 2px 14px;
    color: var(--ink);
    font-size: 13px;
    line-height: 18px;
    font-weight: 600;
  }
  @media (max-width: 560px) {
    .cphotos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
      margin-top: 36px;
      padding-inline: 4px;
    }
    /* На телефоне два снимка: третий в ряд был бы слишком мелким. */
    .cframe:nth-child(3) {
      display: none;
    }
    .cframe {
      padding: 7px 7px 0;
    }
    .cframe__cap {
      padding: 8px 1px 10px;
      font-size: 12px;
      line-height: 16px;
    }
  }
  .adv {
    margin-top: 36px;
    gap: 32px;
  }
  .adv__item {
    padding-top: 18px;
    border-top: 3px solid var(--line);
  }
  .adv__t {
    font-size: 18px;
    line-height: 24px;
    font-weight: 600;
  }
  .adv__item p {
    margin-top: 8px;
    font-size: 15px;
    line-height: 24px;
    color: var(--muted);
  }
  .materials {
    margin-top: 44px;
    padding: 24px 28px;
    background: var(--base);
    border-radius: var(--radius);
    color: #4a4e55;
  }
  .items {
    gap: 20px;
  }
  .item {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .item__t {
    font-size: 20px;
    line-height: 26px;
    font-weight: 600;
  }
  .item__text {
    font-size: 15px;
    line-height: 24px;
    color: #4a4e55;
  }
  .item .plus {
    margin-top: 4px;
  }
  /* Цена и кнопка прижаты к низу карточки — в ряду кнопки стоят на одной линии. */
  .item__foot {
    margin-top: auto;
    padding-top: 10px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .item__price {
    font-size: 14px;
    line-height: 20px;
    color: var(--muted);
  }
  .item__price strong {
    color: var(--ink);
    font-size: 17px;
    font-weight: 800;
    white-space: nowrap;
  }
  .item__price .caption {
    display: block;
    font-size: 13px;
  }
  .plus__more {
    display: none;
    align-self: flex-start;
    padding: 0;
    border: 0;
    background: none;
    color: var(--accent);
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
  }
  @media (max-width: 760px) {
    .item:not(.is-open) .plus .is-extra {
      display: none;
    }
    .plus__more {
      display: inline-block;
      min-height: 32px;
    }
    /* Примеры работ — лента со снапом, карточка на ~3/4 экрана, следующая выглядывает. */
    .pc-works :global(.works) {
      display: flex;
      gap: 14px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .pc-works :global(.works::-webkit-scrollbar) {
      display: none;
    }
    .pc-works :global(.work) {
      flex: 0 0 76%;
      scroll-snap-align: start;
    }
  }
  .uae {
    background: var(--lime);
    border-radius: var(--radius);
    padding: 28px 32px;
  }
  .uae p {
    margin-top: 10px;
  }
  .others-h {
    margin-bottom: 18px;
  }
  .others {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .other {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 18px;
    border: 1px solid var(--line);
    border-radius: 100px;
    background: var(--surface);
    color: var(--ink);
    font-size: 15px;
    font-weight: 600;
  }
  .other:hover {
    border-color: var(--ink);
    color: var(--ink);
  }
  .other :global(svg) {
    color: var(--accent);
  }
</style>
