---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import LeadForm from '@/components/LeadForm.astro';
import { getLang } from '@/i18n';
import { ui } from '@/i18n/ui';
import { CONTACTS, LICENCE_VALID, local, waLink } from '@/consts';

const lang = getLang(Astro.url);
const u = ui(lang);
const L = local(lang);

/** Почта появляется, когда её заведут: пустое значение карточку не рисует. */
const EMAIL = CONTACTS.email;
const T = {
  ru: {
    title: 'Контакты',
    metaTitle: 'Контакты в Дубае: Dubai Design District',
    description: `Телефон и WhatsApp ${CONTACTS.phone}. ${L.hours}. Отвечаем ${L.replyTime}. Адрес: ${L.address}.`,
    lead: `Быстрее всего — написать в WhatsApp. На заявки с сайта отвечаем ${L.replyTime}.`,
    phone: 'WhatsApp и телефон',
    phoneNote: 'Отвечает Кристина, можно звонить',
    write: 'Написать в WhatsApp',
    mailWrite: 'Написать',
    call: 'Позвонить',
    exh: 'Выставки',
    prod: 'Производство',
    details: 'Реквизиты',
    mail: 'Почта',
    activity: 'Вид деятельности',
  },
  en: {
    title: 'Contacts',
    metaTitle: 'Contacts in Dubai: Dubai Design District',
    description: `Phone and WhatsApp ${CONTACTS.phone}. ${L.hours}. We reply ${L.replyTime}. Address: ${L.address}.`,
    lead: `The fastest way to reach us is WhatsApp. We reply to website requests ${L.replyTime}.`,
    phone: 'WhatsApp & phone',
    phoneNote: 'Kristina answers, calls welcome',
    write: 'Message on WhatsApp',
    mailWrite: 'Send an email',
    call: 'Call',
    exh: 'Exhibitions',
    prod: 'Production',
    details: 'Company details',
    mail: 'Email',
    activity: 'Licensed activity',
  },
}[lang];

/** Интервал часов не рвётся по строкам: «9:00–20:00», «9 am – 8 pm». */
const HOURS_RANGE = /(\d{1,2}(?::\d{2})?(?: [ap]m)?\s*–\s*\d{1,2}(?::\d{2})?(?: [ap]m)?)/;
const [hoursPre = '', hoursRange = '', hoursPost = ''] = L.hours.split(HOURS_RANGE);
---

<Base title={T.metaTitle} description={T.description} crumbs={[{ label: T.title }]}>
  <PageHero title={T.title} lead={T.lead} crumbs={[{ label: T.title }]} />

  <section class="section--tight">
    <div class:list={['shell', 'grid', EMAIL ? 'grid--3' : 'grid--2']}>
      {/* Один номер — одна карточка: и WhatsApp, и звонок. */}
      <div class="card c">
        <Icon name="whatsapp" size={28} />
        <span class="caption">{T.phone}</span>
        <strong class="nowrap c__phone">{CONTACTS.phone}</strong>
        <span class="caption">{T.phoneNote}</span>
        <div class="c__actions">
          <a class="btn btn--primary" href={waLink(lang)} target="_blank" rel="noopener">
            <Icon name="whatsapp" size={20} /> {T.write}
          </a>
          <a class="btn btn--ghost" href={CONTACTS.phoneHref}>
            <Icon name="phone" size={18} /> {T.call}
          </a>
        </div>
      </div>
      {
        EMAIL && (
          <a class="card card--link c" href={`mailto:${EMAIL}`}>
            <Icon name="mail" size={28} />
            <span class="caption">{T.mail}</span>
            <strong>{EMAIL}</strong>
            <span class="more">
              {T.mailWrite} <Icon name="arrow" size={16} />
            </span>
          </a>
        )
      }
      <div class="card c">
        <Icon name="clock" size={28} />
        <span class="caption">{u.hours}</span>
        <strong>
          {hoursPre}
          {hoursRange && <span class="nowrap">{hoursRange}</span>}
          {hoursPost}
        </strong>
        <p class="caption c__note">{T.exh}: {L.exhibitionsArea}.<br />{T.prod}: {L.productionArea}.</p>
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="shell">
      <LeadForm />
    </div>
  </section>

  <section class="section--tight">
    <div class="shell">
      <div class="req">
        <span class="eyebrow">{T.details}</span>
        <p>{L.legalName}</p>
        {/* номер лицензии показываем только при действующей лицензии */}
        <p class="caption">{LICENCE_VALID && <>{u.licence} {L.licence} · </>}{L.address}</p>
        {LICENCE_VALID && <p class="caption req__act">{T.activity}: {L.licenceActivity}</p>}
      </div>
    </div>
  </section>
</Base>

<style>
  .c {
    display: flex;
    flex-direction: column;
    gap: 6px;
    color: var(--ink);
  }
  .c:hover {
    color: var(--ink);
  }
  .c > :global(svg:first-child) {
    color: var(--accent);
    margin-bottom: 14px;
  }
  .c strong {
    font-size: 20px;
    line-height: 28px;
  }
  .c .c__phone {
    font-size: 26px;
    line-height: 34px;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }
  /* Действия прижаты к низу карточки; на узкой карточке встают друг под друга. */
  .c__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: auto;
    padding-top: 18px;
  }
  .c__actions .btn {
    flex: 1 1 auto;
  }
  .c__note {
    margin-top: 12px;
  }
  .req p {
    margin-top: 8px;
  }
  @media (max-width: 860px) {
    .c .c__phone {
      font-size: 22px;
      line-height: 30px;
    }
  }
</style>
