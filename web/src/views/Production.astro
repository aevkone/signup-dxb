---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import CtaBand from '@/components/CtaBand.astro';
import { getLang, link } from '@/i18n';
import { categories, TOTAL_ITEMS } from '@/data/production';
import { local } from '@/consts';

const lang = getLang(Astro.url);
const L = local(lang);
const CATS = categories(lang);
const T = {
  ru: {
    title: 'Наружная реклама и производство',
    crumb: 'Производство',
    description: 'Собственное производство наружной рекламы в Дубае, Шардже и Аджмане: световые вывески, широкоформатная печать, брендирование транспорта, таблички, витрины, полиграфия и сувениры.',
    lead: (n: number) => `Девять направлений и ${n} позиций собственного производства. Заказывается отдельно от выставки — или вместе с ней.`,
    prices: (min: string) => `Цены по запросу · минимальный заказ ${min}`,
    survey: (s: string) => `Замер ${s}, засчитывается в стоимость заказа`,
    more: (n: number) => `и ещё ${n}`,
    open: 'Открыть',
  },
  en: {
    title: 'Outdoor advertising & production',
    crumb: 'Production',
    description: 'In-house production of outdoor advertising in Dubai, Sharjah and Ajman: illuminated signs, large-format print, vehicle branding, plaques, shop windows, printing and corporate gifts.',
    lead: (n: number) => `Nine directions and ${n} items made in our own production. Order separately from an exhibition — or together with it.`,
    prices: (min: string) => `Prices on request · minimum order ${min}`,
    survey: (s: string) => `Site survey ${s}, credited towards your order`,
    more: (n: number) => `and ${n} more`,
    open: 'Open',
  },
}[lang];
---

<Base title={T.title} description={T.description}>
  <PageHero title={T.title} lead={T.lead(TOTAL_ITEMS)} crumbs={[{ label: T.crumb }]}>
    <ul class="terms">
      <li><Icon name="pin" size={18} />{L.productionArea}</li>
      <li><Icon name="payment" size={18} />{T.prices(L.minOrder)}</li>
      <li><Icon name="stand" size={18} />{T.survey(L.survey)}</li>
    </ul>
  </PageHero>

  <section class="section--tight">
    <div class="shell grid grid--3 cats">
      {
        CATS.map((c) => (
          <a class="card card--link cat" href={link(`/production/${c.slug}/`, lang)}>
            <Icon name={c.icon} size={28} class="cat__icon" />
            <h2 class="h3">{c.title}</h2>
            <p>{c.short}</p>
            <ul class="cat__items caption">
              {c.items.slice(0, 4).map((it) => (
                <li>{it.title}</li>
              ))}
              {c.items.length > 4 && <li>{T.more(c.items.length - 4)}</li>}
            </ul>
            <span class="more">
              {T.open} <Icon name="arrow" size={16} />
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <CtaBand />
</Base>
<style>
  .terms {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    margin-top: 26px;
    font-size: 15px;
    color: #4a4e55;
  }
  .terms li {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .terms :global(svg) {
    color: var(--accent);
  }
  .cats {
    gap: 20px;
  }
  .cat {
    color: var(--ink);
    gap: 10px;
  }
  .cat:hover {
    color: var(--ink);
  }
  :global(.cat__icon) {
    color: var(--accent);
    margin-bottom: 6px;
  }
  .cat > p {
    color: var(--muted);
    font-size: 16px;
    line-height: 25px;
  }
  .cat__items {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 6px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }
</style>
