---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import Configurator from '@/components/Configurator.astro';
import { featuredWorks } from '@/data/works';
import LeadForm from '@/components/LeadForm.astro';
import { getLang, link } from '@/i18n';
import { ui } from '@/i18n/ui';
import { blocks } from '@/data/exhibitions';
import { categories } from '@/data/production';
import { faq, process } from '@/data/process';
import { TOTAL_PRICES } from '@/data/prices';
import { workById, workTitle } from '@/data/works';
import { CONTACTS } from '@/consts';

const lang = getLang(Astro.url);
const u = ui(lang);
const BLOCKS = blocks(lang);
const CATS = categories(lang);


const T = {
  ru: {
    chip: 'Дубай · Абу-Даби · Шарджа · Аджман',
    h1pre: 'Организуем участие в выставках в Дубае',
    h1script: 'под ключ',
    scriptFirst: false,
    introH: ['Мы — организатор,', 'а не типография'],
    introText: 'Ведём проект целиком: от контракта с организатором до демонтажа после выставки. Вам не нужно собирать подрядчиков по одному — стенд, печать, персонал, питание и логистика идут через один договор.',
    howLink: 'Как мы работаем',
    entriesHa: 'Три входа —',
    entriesHb: 'выберите свой',
    howHa: 'Как мы',
    howHb: 'работаем',
    worksHa: 'Наши',
    worksHb: 'работы',
    prev: 'Предыдущая работа',
    next: 'Следующая работа',
    numbersHa: 'SIGNUP DXB',
    numbersHb: 'в цифрах',
    numbers: ['блоков работы под ключ', 'направлений производства', 'позиций в открытом прайсе', 'эмирата: Дубай, Абу-Даби, Шарджа, Аджман'],
    calcHa: 'Соберите заявку',
    calcHb: 'за минуту',
    photoAlt: 'Работа производства',
    h1: 'Организуем участие в выставках в Дубае под ключ',
    lead: 'Полный цикл — от контракта до демонтажа после выставки. Берите весь пакет или отдельные блоки: подберём объём услуг под ваш бюджет.',
    facts: [
      ['Мы организатор', 'Ведём проект целиком, а не отдельную поставку'],
      ['Прямая связь с площадками', 'Выходим на организаторов напрямую'],
      ['Своё производство', 'Печать и конструкции делаем сами'],
    ],
    oneContract: 'Один договор',
    noContractors: 'Вам не нужно собирать подрядчиков по одному.',
    entries: [
      ['/exhibitions/', 'Выставки под ключ', 'Восемь блоков от концепции стенда до демонтажа. Берите все или один.', 'Смотреть состав'],
      ['/production/', 'Наружная реклама и производство', 'Девять направлений: свет, печать, транспорт, витрины, полиграфия.', 'Открыть каталог'],
      ['/exhibitions/concierge/', 'Консьерж-сервис', 'Встреча, размещение, сим-карты, обмен валюты, перемещение по городу.', 'Что входит'],
    ],
    worksH: 'Наши работы',
    worksSub: 'Примеры изготовленных конструкций: световые вывески, неон, интерьерные логотипы, навигация.',
    worksAll: 'Все работы',
    entriesH: 'Три входа — выберите свой',
    entriesSub: 'Полный цикл — от контракта до демонтажа. Клиент берёт как весь пакет, так и отдельные блоки.',
    inclH: 'Что входит в работу под ключ',
    inclSub: 'Полный цикл — от контракта до демонтажа. Клиент берёт как весь пакет, так и отдельные блоки.',
    allBlocks: 'Все блоки',
    more: 'Подробнее',
    howH: 'Как мы работаем',
    howSub: 'Шесть этапов. На каждом у вас один ответственный контакт, а не пять подрядчиков.',
    calcEyebrow: 'Быстрый расчёт',
    calcH: 'Соберите заявку за минуту',
    calcSub: 'Выберите, что нужно, укажите параметры — вернёмся с вариантами под ваш бюджет. Без звонков, если вам так удобнее.',
    whyH: 'Почему с нами проще',
    why: [
      ['Один договор вместо пяти', 'Стенд, печать, персонал, питание и логистика идут через одного исполнителя.'],
      ['Прямая связь с площадками', 'Выходим на организаторов павильонов напрямую, а не через цепочку посредников.'],
      ['Собственное производство', 'Конструкции и печать делаем сами — сроки не зависят от чужой загрузки.'],
      ['Объём под ваш бюджет', 'Показываем, что входит в каждый уровень, и собираем пакет под вашу сумму.'],
    ],
    caseEyebrow: 'Случай из практики',
    caseText: 'Клиенты неделями не могли выйти на организаторов выставки. Вопрос решился за короткое время — прямым звонком и сообщением в WhatsApp.',
    caseCap: 'Переговоры с организаторами',
    prodEyebrow: 'Собственное производство',
    prodH: 'Наружная реклама и печать',
    prodSub: (n: number, area: string) => `Девять направлений и ${n} позиций — от световых букв до брендирования транспорта. Заказать можно отдельно от выставки. Работаем в эмиратах: ${area}.`,
    openCatalog: 'Открыть каталог',
    byProject: 'по проекту',
    faqH: 'Частые вопросы',
    faqSub: 'Не нашли свой — напишите в WhatsApp, ответим текстом.',
  },
  en: {
    chip: 'Dubai · Abu Dhabi · Sharjah · Ajman',
    h1pre: 'exhibition participation in Dubai',
    h1script: 'Turnkey',
    scriptFirst: true,
    introH: ['We’re the organiser,', 'not a print shop'],
    introText: 'We run the whole project: from the contract with the organiser to breakdown after the show. No need to hire contractors one by one — stand, print, staff, catering and logistics all go through one contract.',
    howLink: 'How we work',
    entriesHa: 'Three ways in —',
    entriesHb: 'pick yours',
    howHa: 'How we',
    howHb: 'work',
    worksHa: 'Our',
    worksHb: 'work',
    prev: 'Previous project',
    next: 'Next project',
    numbersHa: 'SIGNUP DXB',
    numbersHb: 'in numbers',
    numbers: ['turnkey service blocks', 'production directions', 'items in the open price list', 'emirates: Dubai, Abu Dhabi, Sharjah, Ajman'],
    calcHa: 'Put your request together',
    calcHb: 'in a minute',
    photoAlt: 'Production work',
    h1: 'Turnkey exhibition participation in Dubai',
    lead: 'The full cycle — from contract to breakdown after the show. Take the whole package or individual blocks: we’ll shape the scope around your budget.',
    facts: [
      ['We are the organiser', 'We run the whole project, not a single delivery'],
      ['Direct access to venues', 'We reach organisers directly'],
      ['In-house production', 'We make the print and structures ourselves'],
    ],
    oneContract: 'One contract',
    noContractors: 'No need to hire contractors one by one.',
    entries: [
      ['/exhibitions/', 'Turnkey exhibitions', 'Eight blocks from stand concept to breakdown. Take all of them or just one.', 'See what’s included'],
      ['/production/', 'Outdoor advertising & production', 'Nine directions: lighting, print, vehicles, shop windows, printing.', 'Open the catalogue'],
      ['/exhibitions/concierge/', 'Concierge service', 'Arrival, accommodation, SIM cards, currency exchange, getting around the city.', 'What’s included'],
    ],
    worksH: 'Our work',
    worksSub: 'Examples of what we build: illuminated signs, neon, interior logos, wayfinding.',
    worksAll: 'All work',
    entriesH: 'Three ways in — pick yours',
    entriesSub: 'The full cycle — from contract to breakdown. Take the whole package or individual blocks.',
    inclH: 'What turnkey service includes',
    inclSub: 'The full cycle — from contract to breakdown. Clients take either the whole package or individual blocks.',
    allBlocks: 'All blocks',
    more: 'Learn more',
    howH: 'How we work',
    howSub: 'Six stages. At each one you have a single point of contact, not five contractors.',
    calcEyebrow: 'Quick quote',
    calcH: 'Put your request together in a minute',
    calcSub: 'Choose what you need and add the details — we’ll come back with options that fit your budget. No calls needed if you prefer.',
    whyH: 'Why it’s easier with us',
    why: [
      ['One contract instead of five', 'Stand, print, staff, catering and logistics all go through one provider.'],
      ['Direct access to venues', 'We contact hall organisers directly, not through a chain of intermediaries.'],
      ['In-house production', 'We build structures and print ourselves — timelines don’t depend on someone else’s workload.'],
      ['Scope that fits your budget', 'We show what each level includes and put together a package for your budget.'],
    ],
    caseEyebrow: 'A real case',
    caseText: 'Clients had spent weeks unable to reach the exhibition organisers. The issue was resolved quickly — with a direct phone call and a WhatsApp message.',
    caseCap: 'Negotiations with organisers',
    prodEyebrow: 'In-house production',
    prodH: 'Outdoor advertising & print',
    prodSub: (n: number, area: string) => `Nine directions and ${n} items — from illuminated letters to vehicle branding. Can be ordered separately from an exhibition. We work in ${area}.`,
    openCatalog: 'Open the catalogue',
    byProject: 'per project',
    faqH: 'Frequently asked questions',
    faqSub: 'Didn’t find yours? Message us on WhatsApp and we’ll reply in writing.',
  },
}[lang];
const STEPS = process(lang);
const FEATURED = featuredWorks();
/** Колода на первом экране и коллаж — реальные работы из data/works.ts. */
const DECK = ['27', '17', '24'].map((id) => workById(id)!);
const COLLAGE = ['36', '20'].map((id) => workById(id)!);
/** Фото карточек направлений. У выставок и консьержа своих снимков нет —
 *  берём табличку «для выставок» и панораму Дубая. */
const ENTRY_IMG = ['/img/works/w50-600', '/img/works/w27-600', '/img/dubai-hero-800'];
const NUMS = [BLOCKS.length, CATS.length, TOTAL_PRICES, 4];
const w = (id: string, size: number, ext = 'webp') => link(`/img/works/w${id}-${size}.${ext}`);
---

<Base>
  <!-- 1. Первый экран: сцена -->
  <section class="hero stage">
    <picture class="hero__bg" aria-hidden="true">
      <source type="image/webp" media="(max-width: 800px)" srcset={link('/img/dubai-night-800.webp')} />
      <source type="image/webp" media="(max-width: 1280px)" srcset={link('/img/dubai-night-1280.webp')} />
      <source type="image/webp" srcset={link('/img/dubai-night-1920.webp')} />
      <img src={link('/img/dubai-night-1280.jpg')} alt="" width="1920" height="1080" fetchpriority="high" />
    </picture>
    <div class="shell hero__grid">
      <div class="hero__copy">
        <p class="hero__chip">{T.chip}</p>
        <h1 class="hero__title">
          {
            T.scriptFirst ? (
              <>
                <span class="hero__line"><span class="script hero__script">{T.h1script}</span></span>
                <span class="hero__line"><span>{T.h1pre}</span></span>
              </>
            ) : (
              <>
                <span class="hero__line"><span>{T.h1pre}</span></span>
                <span class="hero__line"><span class="script hero__script">{T.h1script}</span></span>
              </>
            )
          }
        </h1>
        <p class="hero__lead">{T.lead}</p>
        <div class="hero__actions">
          <a class="btn btn--primary hero__cta" href={link('/configurator/', lang)}>{u.calc}</a>
          <a class="arrow-link" href={CONTACTS.whatsapp} target="_blank" rel="noopener">
            {u.whatsapp}
            <span class="arrow-link__disc" aria-hidden="true"><Icon name="arrow" size={16} /></span>
          </a>
        </div>
        <ul class="hero__facts">
          {T.facts.map(([h, t]) => <li><strong>{h}</strong><span>{t}</span></li>)}
        </ul>
      </div>
      <div class="deck" data-deck>
        {
          DECK.map((wk, i) => (
            <figure class="deck__card taped" data-card data-pos={i} style={`--i:${i}`}>
              <picture>
                <source type="image/webp" srcset={`${w(wk.id, 600)} 600w, ${w(wk.id, 1200)} 1200w`} sizes="(max-width: 980px) 70vw, 420px" />
                <img src={w(wk.id, 600, 'jpg')} width="600" height="600" alt={workTitle(wk, lang)} fetchpriority={i === 0 ? 'high' : 'auto'} />
              </picture>
              <figcaption>{workTitle(wk, lang)}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 2. Позиционирование -->
  <section class="section intro">
    <div class="shell intro__grid">
      <div class="collage" aria-hidden="true">
        {
          COLLAGE.map((wk, i) => (
            <picture class:list={['collage__ph', 'taped', `collage__ph--${i + 1}`]} data-reveal style={`--d:${i * 140}ms`}>
              <source type="image/webp" srcset={w(wk.id, 600)} />
              <img src={w(wk.id, 600, 'jpg')} width="600" height="600" alt="" loading="lazy" />
            </picture>
          ))
        }
      </div>
      <div class="intro__copy">
        <h2 class="h2">{T.introH[0]} <span class="script">{T.introH[1]}</span></h2>
        <p class="intro__text">{T.introText}</p>
        <ul class="promises">
          {T.why.map(([h, t], i) => (
            <li data-reveal style={`--d:${i * 90}ms`}>
              <span class="promises__tick" aria-hidden="true"><Icon name="check" size={16} /></span>
              <div><strong>{h}</strong><span>{t}</span></div>
            </li>
          ))}
        </ul>
        <figure class="case">
          <blockquote>{T.caseText}</blockquote>
          <figcaption>{T.caseCap}</figcaption>
        </figure>
        <a class="arrow-link" href="#process">
          {T.howLink}
          <span class="arrow-link__disc" aria-hidden="true"><Icon name="arrow" size={16} /></span>
        </a>
      </div>
    </div>
  </section>

  <!-- 3. Направления -->
  <section class="section entries">
    <div class="shell">
      <div class="sec-head">
        <div>
          <h2 class="h2">{T.entriesHa} <span class="script">{T.entriesHb}</span></h2>
          <p class="measure sec-head__sub">{T.entriesSub}</p>
        </div>
      </div>
      <div class="entries__grid">
        {
          T.entries.map(([href, h, p, m], i) => (
            <a class="entry" href={link(href, lang)} data-reveal style={`--d:${i * 120}ms`}>
              <div class="entry__media taped" data-drift>
                <picture>
                  <source type="image/webp" srcset={link(`${ENTRY_IMG[i]}.webp`)} />
                  <img src={link(`${ENTRY_IMG[i]}.jpg`)} width="600" height="600" alt="" loading="lazy" />
                </picture>
              </div>
              <h3 class="entry__title">{h}</h3>
              <p class="entry__text">{p}</p>
              <span class="arrow-link">
                {m}
                <span class="arrow-link__disc" aria-hidden="true"><Icon name="arrow" size={16} /></span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. Что входит -->
  <section class="section incl">
    <div class="shell">
      <div class="sec-head">
        <div>
          <h2 class="h2">{T.inclH}</h2>
          <p class="measure sec-head__sub">{T.inclSub}</p>
        </div>
        <a class="btn btn--ghost" href={link('/exhibitions/', lang)}>{T.allBlocks}</a>
      </div>
      <ul class="incl__list">
        {
          BLOCKS.map((b) => (
            <li>
              <a class="incl__row" href={link(`/exhibitions/${b.slug}/`, lang)}>
                <Icon name={b.icon} size={26} class="incl__icon" />
                <span class="incl__t">{b.title}</span>
                <span class="incl__s">{b.short}</span>
                <Icon name="arrow" size={18} class="incl__arrow" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 5. Схема работы -->
  <section class="section stage how" id="process">
    <div class="shell">
      <div class="sec-head sec-head--center">
        <h2 class="h2">{T.howHa} <span class="script">{T.howHb}</span></h2>
        <p class="measure sec-head__sub">{T.howSub}</p>
      </div>
      <ol class="flow" data-process>
        <span class="flow__rail" aria-hidden="true"><span class="flow__fill"></span></span>
        {
          STEPS.map((s, i) => (
            <li class:list={['flow__step', i % 2 ? 'flow__step--r' : 'flow__step--l']} data-step>
              <span class="flow__dot" data-dot aria-hidden="true">{i + 1}</span>
              <div class="flow__card">
                <h3 class="flow__t">{s.title}</h3>
                <p class="flow__p">{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 6. Карусель работ -->
  <section class="section works" data-carousel>
    <div class="shell">
      <div class="sec-head">
        <div>
          <h2 class="h2">{T.worksHa} <span class="script">{T.worksHb}</span></h2>
          <p class="measure sec-head__sub">{T.worksSub}</p>
        </div>
        <a class="arrow-link" href={link('/works/', lang)}>
          {T.worksAll}
          <span class="arrow-link__disc" aria-hidden="true"><Icon name="arrow" size={16} /></span>
        </a>
      </div>
    </div>
    <div class="car">
      <div class="car__track" data-track tabindex="0" role="region" aria-roledescription="carousel" aria-label={T.worksHa + ' ' + T.worksHb}>
        {
          FEATURED.map((wk) => (
            <figure class="car__slide" data-slide>
              <a href={w(wk.id, 1200)} target="_blank" rel="noopener">
                <picture>
                  <source type="image/webp" srcset={`${w(wk.id, 600)} 600w, ${w(wk.id, 1200)} 1200w`} sizes="(max-width: 700px) 78vw, 560px" />
                  <img src={w(wk.id, 600, 'jpg')} width="600" height="600" alt={workTitle(wk, lang)} loading="lazy" />
                </picture>
              </a>
              <figcaption>{workTitle(wk, lang)}</figcaption>
            </figure>
          ))
        }
      </div>
      <div class="car__nav">
        <button class="car__btn" type="button" data-prev aria-label={T.prev}><Icon name="arrow" size={20} /></button>
        <span class="car__count" data-counter aria-live="polite">1 / {FEATURED.length}</span>
        <button class="car__btn" type="button" data-next aria-label={T.next}><Icon name="arrow" size={20} /></button>
      </div>
    </div>
  </section>

  <!-- 7. Цифры -->
  <section class="section numbers">
    <div class="shell">
      <h2 class="h2 numbers__h">{T.numbersHa} <span class="script">{T.numbersHb}</span></h2>
      <ul class="numbers__row">
        {
          NUMS.map((n, i) => (
            <li data-reveal style={`--d:${i * 100}ms`}>
              <span class="numbers__n" data-count={n}>{n}</span>
              <span class="numbers__l">{T.numbers[i]}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 8. Конфигуратор -->
  <section class="section calc" id="calc">
    <div class="shell">
      <div class="sec-head">
        <div>
          <h2 class="h2">{T.calcHa} <span class="script">{T.calcHb}</span></h2>
          <p class="measure sec-head__sub">{T.calcSub}</p>
        </div>
      </div>
      <Configurator />
    </div>
  </section>

  <!-- 9. Вопросы -->
  <section class="section faqs">
    <div class="shell faq">
      <div>
        <h2 class="h2">{T.faqH}</h2>
        <p class="sec-head__sub">{T.faqSub}</p>
      </div>
      <div class="faq__list">
        {
          faq(lang).map((f) => (
            <details class="faq__item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 10. Форма -->
  <section class="section stage lead-band" id="lead">
    <div class="shell">
      <LeadForm />
    </div>
  </section>
</Base>

<style>
  /* ---------- 1. Первый экран ---------- */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: 88px 96px;
    /* На высоких мониторах первый экран не растягивается бесконечно. */
    min-height: min(calc(100svh - 84px), 960px);
    display: grid;
    align-items: center;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
    opacity: 0.42;
    filter: saturate(0.8);
  }
  /* Чёрная сцена сверху и сливовое свечение снизу — как у образца, в цветах Кристины. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(100deg, var(--stage) 0%, rgb(15 16 13 / 0.92) 38%, rgb(15 16 13 / 0.35) 72%, rgb(15 16 13 / 0.2) 100%),
      linear-gradient(180deg, rgb(15 16 13 / 0) 45%, rgb(89 51 95 / 0.85) 100%);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.8fr);
    gap: 56px;
    align-items: center;
  }
  .hero__chip {
    display: inline-block;
    padding: 8px 16px;
    border: 1px solid var(--stage-line);
    border-radius: var(--pill);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.4px;
    color: var(--on-stage-muted);
  }
  .hero__title {
    margin-top: 26px;
    font-size: clamp(40px, 4.9vw, 70px);
    line-height: 1.02;
    font-weight: 800;
    letter-spacing: -0.035em;
    color: #fff;
    text-wrap: balance;
  }
  .hero__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }
  .hero__line > span {
    display: inline-block;
  }
  .hero__script {
    font-size: 1.28em;
    line-height: 0.95;
    color: var(--olive-pastel);
  }
  .hero__lead {
    margin-top: 26px;
    max-width: 560px;
    font-size: 18px;
    line-height: 30px;
