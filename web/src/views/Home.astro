---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import Configurator from '@/components/Configurator.astro';
import HeroMotion from '@/components/HeroMotion.astro';
import HeroStand from '@/components/HeroStand.astro';
import HeroNeon from '@/components/HeroNeon.astro';
import { featuredWorks } from '@/data/works';
import LeadForm from '@/components/LeadForm.astro';
import { getLang, link } from '@/i18n';
import { ui } from '@/i18n/ui';
import { blocks } from '@/data/exhibitions';
import { faq, process } from '@/data/process';
import { workById, workTitle } from '@/data/works';
import { CONTACTS } from '@/consts';

/** Сцена первого экрана: на сайте — 3D-стенд; ui и neon — запасные варианты (смотреть на /proto/ в разработке). */
type Props = { hero?: 'ui' | 'stand' | 'neon' };
const { hero = 'stand' } = Astro.props;
const lang = getLang(Astro.url);
const u = ui(lang);
const BLOCKS = blocks(lang);

const T = {
  ru: {
    h1pre: 'Организуем участие в выставках в Дубае',
    h1script: 'под ключ',
    scriptFirst: false,
    lead: 'От контракта с организатором до демонтажа после выставки. Берите весь пакет или отдельные блоки — подберём объём под ваш бюджет.',
    facts: [
      ['Один договор', 'Стенд, печать, персонал и логистика — у одного исполнителя'],
      ['Прямая связь с площадками', 'Выходим на организаторов напрямую'],
      ['Производство в ОАЭ', 'Печать и конструкции — работаем с производством напрямую'],
    ],
    introH: 'Одна команда на всю выставку',
    introText: 'Ведём проект целиком: бронь места, стенд, печать, персонал, питание и логистику. На каждом этапе у вас один ответственный контакт — не нужно искать подрядчиков и сводить их сроки.',
    promises: [
      ['Помощь с оплатой участия', 'По агентскому договору оплачиваем участие организатору и передаём закрывающие документы.'],
      ['Проверка по регламенту', 'Сверяем проект стенда с правилами площадки до того, как он уйдёт в производство.'],
    ],
    callH: 'Организатор не отвечает?',
    callText: 'Выходим на павильон напрямую — звонком и в WhatsApp.',
    callLink: 'Переговоры с организаторами',
    howLink: 'Как мы работаем',
    entriesH: 'Три направления работы',
    entriesSub: 'Выставки под ключ, наружная реклама и консьерж-сервис — каждое направление можно заказать отдельно.',
    entries: [
      ['/exhibitions/', 'Выставки под ключ', 'Восемь блоков работы — от концепции стенда до демонтажа.', 'Смотреть состав'],
      ['/production/', 'Наружная реклама и производство', 'Световые вывески, печать, оклейка транспорта, витрины, полиграфия.', 'Открыть каталог'],
      ['/exhibitions/concierge/', 'Консьерж-сервис', 'Встреча, размещение, сим-карты, обмен валюты, перемещение по городу.', 'Что входит'],
    ],
    conciergeAlt: 'Панорама Дубая днём: небоскрёбы и побережье',
    inclH: 'Что входит в работу под ключ',
    inclSub: 'У каждого блока своя страница с составом работ. Берите все восемь или только нужные.',
    allBlocks: 'Все блоки',
    howHa: 'Как мы',
    howHb: 'работаем',
    howSub: 'Шесть этапов — от первой заявки до демонтажа и итогов выставки.',
    worksH: 'Примеры работ',
    worksSub: 'Изготовленные конструкции: световые вывески, неон, интерьерные логотипы, навигация.',
    worksAll: 'Все работы',
    prev: 'Предыдущая работа',
    next: 'Следующая работа',
    /** Условия — из прайса (TERMS_RU в data/prices.ts) и consts.ts: «24 часа» — это replyTime «в течение суток». Менять вместе с ними. */
    termsH: 'Условия работы',
    terms: [
      ['24', 'часа', 'Срок ответа на заявку'],
      ['50/50', '', 'Оплата: 50% предоплата, 50% перед отгрузкой или монтажом'],
      ['500', 'AED', 'Выезд на замер — сумма засчитывается в заказ'],
      ['12', 'месяцев', 'Гарантия на конструкции и электрику'],
    ],
    termsLink: 'Все условия — в прайсе',
    calcH: 'Соберите заявку за минуту',
    calcSub: 'Отметьте, что нужно, и укажите параметры — вернёмся с вариантами. Без звонков, если вам так удобнее.',
    faqH: 'Частые вопросы',
    faqSub: 'Не нашли свой — напишите в WhatsApp, ответим текстом.',
  },
  en: {
    h1pre: 'exhibitions in Dubai',
    h1script: 'Turnkey',
    scriptFirst: true,
    lead: 'From the organiser’s contract to breakdown after the show. Take the full package or just the services you need — we’ll fit the scope to your budget.',
    facts: [
      ['One contract', 'Stand, print, staff and logistics from a single team'],
      ['Direct line to venues', 'We deal with organisers directly'],
      ['Production in the UAE', 'Print and structures — we work with production directly'],
    ],
    introH: 'One team for your whole exhibition',
    introText: 'We handle the whole project: space booking, stand, print, staff, catering and logistics. You have one point of contact at every stage — no hunting for contractors or juggling their schedules.',
    promises: [
      ['Help with participation fees', 'Under an agency agreement, we pay the organiser for you and hand over the supporting documents.'],
      ['Checked against venue rules', 'We check the stand design against the venue’s regulations before it goes into production.'],
    ],
    callH: 'Organiser not responding?',
    callText: 'We reach the venue directly — by phone and on WhatsApp.',
    callLink: 'Negotiations with organisers',
    howLink: 'How we work',
    entriesH: 'Three ways we can help',
    entriesSub: 'Turnkey exhibitions, outdoor advertising and concierge — each is available on its own.',
    entries: [
      ['/exhibitions/', 'Turnkey exhibitions', 'Eight services, from stand concept to breakdown.', 'See what’s included'],
      ['/production/', 'Signage & outdoor advertising', 'Illuminated signs, print, vehicle wraps, shop windows and printed materials.', 'Browse the catalogue'],
      ['/exhibitions/concierge/', 'Concierge', 'Airport pickup, accommodation, SIM cards, currency exchange and getting around.', 'What’s included'],
    ],
    conciergeAlt: 'Dubai skyline by day: high-rises and the coast',
    inclH: 'What’s included in turnkey service',
    inclSub: 'Each service has its own page with the full scope. Take all eight or only what you need.',
    allBlocks: 'All services',
    howHa: 'How we',
    howHb: 'work',
    howSub: 'Six stages, from your first request to breakdown and wrap-up.',
    worksH: 'Examples of work',
    worksSub: 'Finished pieces: illuminated signs, neon, interior logos and wayfinding.',
    worksAll: 'See all work',
    prev: 'Previous project',
    next: 'Next project',
    /** Условия — из прайса (TERMS_EN в data/prices.en.ts) и consts.ts (replyTime «within 24 hours»). */
    termsH: 'Key terms',
    terms: [
      ['24', 'hours', 'Response time to your request'],
      ['50/50', '', 'Payment: 50% upfront, 50% before dispatch or installation'],
      ['500', 'AED', 'Site survey visit, credited against the order', 'before'],
      ['12', 'months', 'Warranty on structures and electrics'],
    ],
    termsLink: 'Full terms in the price list',
    calcH: 'Build your request in a minute',
    calcSub: 'Tick what you need and add the details — we’ll come back with options. No phone call needed if you’d rather not.',
    faqH: 'Frequently asked questions',
    faqSub: 'Don’t see your question? Ask on WhatsApp — we’ll reply in writing.',
  },
}[lang];
const STEPS = process(lang);
const FEATURED = featuredWorks();
/** Коллаж — реальные работы из data/works.ts. */
const COLLAGE = ['36', '20'].map((id) => workById(id)!);
/** Фото карточек направлений. У выставок и консьержа своих снимков нет —
 *  берём табличку «для выставок» и панораму Дубая. */
const ENTRY_IMG = ['/img/works/w50-600', '/img/works/w27-600', '/img/concierge'];
/** Подписи к фото карточек: у работ — название из data/works.ts, у консьержа — описание панорамы. */
const ENTRY_ALT = [workTitle(workById('50')!, lang), workTitle(workById('27')!, lang), T.conciergeAlt];
/** У консьержа своё чёткое фото Дубая в двух размерах; у работ — по одному. */
const entrySet = (i: number, ext: string) =>
  i === 2 ? `${link(`${ENTRY_IMG[i]}-800.${ext}`)} 800w, ${link(`${ENTRY_IMG[i]}-1200.${ext}`)} 1200w` : link(`${ENTRY_IMG[i]}.${ext}`);
const w = (id: string, size: number, ext = 'webp') => link(`/img/works/w${id}-${size}.${ext}`);
---

<Base>
  <!-- 1. Первый экран: сцена -->
  <section class:list={['hero', 'stage', `hero--${hero}`]}>
    <picture class="hero__bg" aria-hidden="true">
      <source type="image/webp" media="(max-width: 800px)" srcset={link('/img/dubai-night-800.webp')} />
      <source type="image/webp" media="(max-width: 1280px)" srcset={link('/img/dubai-night-1280.webp')} />
      <source type="image/webp" srcset={link('/img/dubai-night-1920.webp')} />
      <img src={link('/img/dubai-night-1280.jpg')} alt="" width="1920" height="1080" fetchpriority="high" />
    </picture>
    <div class="shell hero__grid">
      <div class="hero__copy">
        <h1 class="hero__title">
          {
            T.scriptFirst ? (
              <>
                <span class="hero__line"><span class="script hero__script">{T.h1script}</span></span>
                <span class="hero__line"><span>{T.h1pre}</span></span>
              </>
            ) : (
              <>
                <span class="hero__line"><span>{T.h1pre}</span></span>
                <span class="hero__line"><span class="script hero__script">{T.h1script}</span></span>
              </>
            )
          }
        </h1>
        <p class="hero__lead">{T.lead}</p>
        <div class="hero__actions">
          <a class="btn btn--primary hero__cta" href={link('/configurator/', lang)}>{u.calc}</a>
          <a class="arrow-link" href={CONTACTS.whatsapp} target="_blank" rel="noopener">
            {u.whatsapp}
            <span class="arrow-link__disc" aria-hidden="true"><Icon name="arrow" size={16} /></span>
          </a>
        </div>
        <ul class="hero__facts">
          {T.facts.map(([h, t]) => <li><strong>{h}</strong><span>{t}</span></li>)}
        </ul>
      </div>
      {hero === 'stand' ? <HeroStand /> : hero === 'neon' ? <HeroNeon /> : <HeroMotion />}
    </div>
  </section>

  <!-- 2. Позиционирование -->
  <section class="section intro">
    <div class="shell intro__grid">
      <div class="collage">
        {
          COLLAGE.map((wk, i) => (
            <picture class:list={['collage__ph', 'taped', `collage__ph--${i + 1}`]} data-reveal style={`--d:${i * 140}ms`}>
              <source type="image/webp" srcset={w(wk.id, 600)} />
              <img src={w(wk.id, 600, 'jpg')} width="600" height="600" alt={workTitle(wk, lang)} loading="lazy" />
            </picture>
          ))
        }
      </div>
      <div class="intro__copy">
        <h2 class="h2">{T.introH}</h2>
        <p class="intro__text">{T.introText}</p>
        <ul class="promises">
          {T.promises.map(([h, t], i) => (
            <li data-reveal style={`--d:${i * 90}ms`}>
              <span class="promises__tick" aria-hidden="true"><Icon name="check" size={16} /></span>
              <div><strong>{h}</strong><span>{t}</span></div>
            </li>
          ))}
        </ul>
        <div class="callout">
          <Icon name="talks" size={26} class="callout__icon" />
          <p class="callout__text"><strong>{T.callH}</strong> {T.callText}</p>
          <a class="callout__link" href={link('/exhibitions/negotiations/', lang)}>{T.callLink}</a>
        </div>
        <a class="arrow-link" href="#process">
          {T.howLink}
          <span class="arrow-link__disc" aria-hidden="true"><Icon name="arrow" size={16} /></span>
        </a>
      </div>
    </div>
  </section>

  <!-- 3. Направления -->
  <section class="section entries">
    <div class="shell">
      <div class="sec-head">
        <div>
          <h2 class="h2">{T.entriesH}</h2>
          <p class="measure sec-head__sub">{T.entriesSub}</p>
        </div>
      </div>
      <div class="entries__grid">
        {
          T.entries.map(([href, h, p, m], i) => (
            <a class="entry" href={link(href, lang)} data-reveal style={`--d:${i * 120}ms`}>
              <div class="entry__media" data-drift>
                <picture>
                  <source type="image/webp" srcset={entrySet(i, 'webp')} sizes="(max-width: 760px) 92vw, (max-width: 1080px) 46vw, 400px" />
                  <img src={i === 2 ? link(`${ENTRY_IMG[i]}-800.jpg`) : link(`${ENTRY_IMG[i]}.jpg`)} srcset={i === 2 ? entrySet(i, 'jpg') : undefined} sizes="(max-width: 760px) 92vw, (max-width: 1080px) 46vw, 400px" width="600" height="600" alt={ENTRY_ALT[i]} loading="lazy" />
                </picture>
              </div>
              <h3 class="entry__title">{h}</h3>
              <p class="entry__text">{p}</p>
              <span class="arrow-link">
                {m}
                <span class="arrow-link__disc" aria-hidden="true"><Icon name="arrow" size={16} /></span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. Что входит -->
  <section class="section incl">
    <div class="shell">
      <div class="sec-head">
        <div>
          <h2 class="h2">{T.inclH}</h2>
          <p class="measure sec-head__sub">{T.inclSub}</p>
        </div>
        <a class="btn btn--ghost" href={link('/exhibitions/', lang)}>{T.allBlocks}</a>
      </div>
      <ul class="incl__list">
        {
          BLOCKS.map((b) => (
            <li>
              <a class="incl__row" href={link(`/exhibitions/${b.slug}/`, lang)}>
                <Icon name={b.icon} size={26} class="incl__icon" />
                <span class="incl__t">{b.title}</span>
                <span class="incl__s">{b.short}</span>
                <Icon name="arrow" size={18} class="incl__arrow" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 5. Схема работы -->
  <section class="section stage how" id="process">
    <div class="shell">
      <div class="sec-head sec-head--center">
        <h2 class="h2">{T.howHa} <span class="script">{T.howHb}</span></h2>
        <p class="measure sec-head__sub">{T.howSub}</p>
      </div>
      <ol class="flow" data-process>
        <span class="flow__rail" aria-hidden="true"><span class="flow__fill"></span></span>
        {
          STEPS.map((s, i) => (
            <li class:list={['flow__step', i % 2 ? 'flow__step--r' : 'flow__step--l']} data-step>
              <span class="flow__dot" data-dot aria-hidden="true">{i + 1}</span>
              <div class="flow__card">
                <h3 class="flow__t">{s.title}</h3>
                <p class="flow__p">{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 6. Карусель работ -->
  <section class="section works" data-carousel>
    <div class="shell">
      <div class="sec-head">
        <div>
          <h2 class="h2">{T.worksH}</h2>
          <p class="measure sec-head__sub">{T.worksSub}</p>
        </div>
        <a class="arrow-link" href={link('/works/', lang)}>
          {T.worksAll}
          <span class="arrow-link__disc" aria-hidden="true"><Icon name="arrow" size={16} /></span>
        </a>
      </div>
    </div>
    <div class="car">
      <div class="car__track" data-track tabindex="0" role="region" aria-roledescription="carousel" aria-label={T.worksH}>
        {
          FEATURED.map((wk) => (
            <figure class="car__slide" data-slide>
              <a href={w(wk.id, 1200)} target="_blank" rel="noopener">
                <picture>
                  <source type="image/webp" srcset={`${w(wk.id, 600)} 600w, ${w(wk.id, 1200)} 1200w`} sizes="(max-width: 700px) 78vw, 560px" />
                  <img src={w(wk.id, 600, 'jpg')} width="600" height="600" alt={workTitle(wk, lang)} loading="lazy" />
                </picture>
              </a>
              <figcaption>{workTitle(wk, lang)}</figcaption>
            </figure>
          ))
        }
      </div>
      <div class="car__nav">
        <button class="car__btn" type="button" data-prev aria-label={T.prev}><Icon name="arrow" size={20} /></button>
        <span class="car__count" data-counter aria-live="polite">2 / {FEATURED.length}</span>
        <button class="car__btn" type="button" data-next aria-label={T.next}><Icon name="arrow" size={20} /></button>
      </div>
    </div>
  </section>

  <!-- 7. Условия работы: факты из прайса и consts.ts, без счётчиков -->
  <section class="section terms">
    <div class="shell">
      <h2 class="h2">{T.termsH}</h2>
      <ul class="terms__row">
        {
          T.terms.map(([n, unit, label, order], i) => (
            <li data-reveal style={`--d:${i * 100}ms`}>
              <span class:list={['terms__v', order === 'before' && 'terms__v--rev']}>
                <span class="terms__n">{n}</span>
                {unit && <span class="terms__u">{unit}</span>}
              </span>
              <span class="terms__l">{label}</span>
            </li>
          ))
        }
      </ul>
      <a class="arrow-link terms__link" href={link('/prices/', lang)}>
        {T.termsLink}
        <span class="arrow-link__disc" aria-hidden="true"><Icon name="arrow" size={16} /></span>
      </a>
    </div>
  </section>

  <!-- 8. Конфигуратор -->
  <section class="section calc" id="calc">
    <div class="shell">
      <div class="sec-head">
        <div>
          <h2 class="h2">{T.calcH}</h2>
          <p class="measure sec-head__sub">{T.calcSub}</p>
        </div>
      </div>
      <Configurator />
    </div>
  </section>

  <!-- 9. Вопросы -->
  <section class="section faqs">
    <div class="shell faq">
      <div>
        <h2 class="h2">{T.faqH}</h2>
        <p class="sec-head__sub">{T.faqSub}</p>
      </div>
      <div class="faq__list">
        {
          faq(lang).map((f) => (
            <details class="faq__item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 10. Форма -->
  <section class="section stage lead-band" id="lead">
    <div class="shell">
      <LeadForm />
    </div>
  </section>
</Base>

<style>
  /* ---------- 1. Первый экран ---------- */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: 88px 96px;
    /* На высоких мониторах первый экран не растягивается бесконечно. */
    min-height: min(calc(100svh - 84px), 960px);
    display: grid;
    align-items: center;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
    opacity: 0.42;
    filter: saturate(0.8);
  }
  /* Вариант с ночным городом: своя панорама в сцене, фото фона приглушаем. */
  .hero--neon .hero__bg img {
    opacity: 0.14;
  }
  /* Чёрная сцена сверху и сливовое свечение снизу — как у образца, в цветах Кристины. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(100deg, var(--stage) 0%, rgb(15 16 13 / 0.92) 38%, rgb(15 16 13 / 0.35) 72%, rgb(15 16 13 / 0.2) 100%),
      linear-gradient(180deg, rgb(15 16 13 / 0) 45%, rgb(89 51 95 / 0.85) 100%);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 48px;
    align-items: center;
  }
  /* 3D-стенд на компьютере — в 1,5 раза крупнее колонки и на уровне заголовка.
     Мягкие края сцены уходят в фон, поэтому выход за колонку незаметен. */
  @media (min-width: 1081px) {
    .hero__grid > :global(.hs) {
      width: 150%;
      max-width: none;
      margin-inline: -22% -28%;
      align-self: start;
      margin-top: -16%;
      margin-bottom: -18%;
      justify-self: stretch;
    }
  }
  .hero__title {
    font-size: clamp(38px, 4vw, 58px);
    line-height: 1.02;
    font-weight: 800;
    letter-spacing: -0.035em;
    color: #fff;
    text-wrap: balance;
  }
  .hero__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }
  .hero__line > span {
    display: inline-block;
  }
  .hero__script {
    font-size: 1.28em;
    line-height: 0.95;
    color: var(--olive-pastel);
  }
  .hero__lead {
    margin-top: 26px;
    max-width: 560px;
    font-size: 18px;
    line-height: 30px;
    color: var(--on-stage-muted);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 28px;
    margin-top: 36px;
  }
  .hero__cta {
    height: 56px;
    padding-inline: 32px;
  }
  .hero__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-top: 56px;
    padding-top: 26px;
    border-top: 1px solid var(--stage-line);
  }
  .hero__facts li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 14px;
    line-height: 21px;
    color: var(--on-stage-muted);
