---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Works from '@/components/Works.astro';
import CtaBand from '@/components/CtaBand.astro';
import { getLang } from '@/i18n';
import { works } from '@/data/works';

const lang = getLang(Astro.url);
const T = {
  ru: {
    title: 'Наши работы',
    metaTitle: 'Наши работы: вывески и наружная реклама в Дубае',
    description: 'Примеры наружной и интерьерной рекламы, которую мы сделали: световые вывески и буквы, неон, крышные установки, навигация, оформление витрин и транспорта.',
    lead: 'Световые вывески и буквы, неон, крышные установки, навигация, интерьерные логотипы, витрины и транспорт. Нажмите на фото, чтобы открыть его крупно.',
    grid: 'Все работы',
  },
  en: {
    title: 'Our work',
    metaTitle: 'Our work: signage & outdoor advertising in Dubai',
    description: 'Examples of outdoor and interior advertising we build: illuminated signs and letters, neon, rooftop structures, wayfinding, window and vehicle branding.',
    lead: 'Illuminated signs and letters, neon, rooftop structures, wayfinding, interior logos, windows and vehicles. Click a photo to open it full size.',
    grid: 'All work',
  },
}[lang];
---

<Base title={T.metaTitle} description={T.description} crumbs={[{ label: T.title }]}>
  <PageHero title={T.title} lead={T.lead} crumbs={[{ label: T.title }]} />
  <section class="section--tight" style="padding-top:0">
    <div class="shell">
      <Works title={T.grid} list={works()} bare />
    </div>
  </section>
  <CtaBand />
</Base>
