---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Works from '@/components/Works.astro';
import ExpoCase from '@/components/ExpoCase.astro';
import CtaBand from '@/components/CtaBand.astro';
import { getLang } from '@/i18n';
import { works } from '@/data/works';

const lang = getLang(Astro.url);
const T = {
  ru: {
    title: 'Наши работы',
    metaTitle: 'Наши работы: выставочный стенд и вывески в Дубае',
    description: 'Наш выставочный проект — стенд PARIMIR на Beautyworld Middle East — и примеры наружной и интерьерной рекламы: световые вывески и буквы, неон, крышные установки, навигация, витрины и транспорт.',
    lead: 'Выставочный проект на Beautyworld Middle East и вывески, которые мы сделали. Нажмите на фото, чтобы открыть его крупно.',
    expoH: 'Выставки',
    signsH: 'Вывески и конструкции',
  },
  en: {
    title: 'Our work',
    metaTitle: 'Our work: exhibition stand and signage in Dubai',
    description: 'Our exhibition project — the PARIMIR stand at Beautyworld Middle East — and examples of outdoor and interior advertising: illuminated signs and letters, neon, rooftop structures, wayfinding, windows and vehicles.',
    lead: 'Our exhibition project at Beautyworld Middle East and the signage we have made. Click a photo to open it full size.',
    expoH: 'Exhibitions',
    signsH: 'Signage and structures',
  },
}[lang];
---

<Base title={T.metaTitle} description={T.description} crumbs={[{ label: T.title }]}>
  <PageHero title={T.title} lead={T.lead} crumbs={[{ label: T.title }]} />
  {/* Сначала выставки — главное направление, затем вывески. */}
  <section class="section--tight" aria-labelledby="works-expo-h">
    <div class="shell">
      <h2 class="h2 works__h" id="works-expo-h">{T.expoH}</h2>
      <ExpoCase bare level={3} />
    </div>
  </section>
  <section class="section--tight">
    <div class="shell">
      <Works title={T.signsH} list={works()} bare />
    </div>
  </section>
  <CtaBand />
</Base>

<style>
  .works__h {
    margin-bottom: 28px;
  }
</style>
