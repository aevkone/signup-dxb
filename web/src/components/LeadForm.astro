---
import Icon from './Icon.astro';
import LeadDone from './LeadDone.astro';
import { getLang, link } from '@/i18n';
import { ui } from '@/i18n/ui';
import { CONTACTS, local, waLink } from '@/consts';

interface Props {
  title?: string;
  /** Подставляется в поле «Задача», когда форма стоит на странице услуги. */
  context?: string;
  /** Подсказка в поле «Задача» под тему страницы; по умолчанию — выставочная. */
  placeholder?: string;
}
const lang = getLang(Astro.url);
const t = ui(lang);
const L = local(lang);
const { title = t.leadTitle, context, placeholder = t.taskPh } = Astro.props;
/** В сообщение WhatsApp уходит сам раздел, без «Интересует:» из поля задачи. */
const wa = waLink(lang, context?.replace(`${t.interested}: `, ''));
---

<div class="lead">
  <div class="lead__info">
    <h2 class="h2">{title}</h2>
    <p class="lead__sub">{t.leadSub(L.replyTime)}</p>
    <ul class="lead__contacts">
      <li>
        <Icon name="phone" size={20} />
        <div>
          <span class="caption">{t.phoneWa}</span>
          <a class="lead__phone" href={CONTACTS.phoneHref}>{CONTACTS.phone}</a>
        </div>
      </li>
      <li>
        <Icon name="clock" size={20} />
        <div>
          <span class="caption">{t.hours}</span>
          <span>{L.hours}</span>
        </div>
      </li>
    </ul>
    <a class="btn btn--ghost" href={wa} target="_blank" rel="noopener">
      <Icon name="whatsapp" size={20} /> {t.whatsapp}
    </a>
  </div>

  <form
    class="lead__form card"
    data-lead-form
    data-short-phone={t.shortPhone}
    data-again={t.again}
    novalidate
  >
    <label class="field">
      <span>{t.name} <span class="caption field__opt">{t.optional}</span></span>
      <input class="input" name="name" autocomplete="name" placeholder={t.namePh} />
    </label>
    <label class="field">
      <span>{t.contact}</span>
      <input class="input" name="contact" type="tel" autocomplete="tel" placeholder={t.contactPh} required aria-required="true" />
    </label>
    <label class="field">
      <span>{t.task} <span class="caption field__opt">{t.optional}</span></span>
      <textarea class="textarea" name="task" rows="3" autocomplete="off" placeholder={placeholder}>{context}</textarea>
    </label>
    <p class="lead__error" data-error role="alert" hidden>{t.noContact}</p>
    <button class="btn btn--primary" type="submit" data-submit>{t.submit}</button>
    <p class="lead__trust caption">{t.trust(L.replyTime)}</p>
    <p class="caption">
      {t.consent} <a class="lead__privacy" href={link('/consent/', lang)}>{t.consentLink}</a>.
    </p>
    <LeadDone text={t.sentText(L.replyTime)} />
  </form>
</div>

<script>
  import { sendLead, wireDone } from '@/scripts/lead';

  /** Пауза после нажатия: повторный тап не открывает второй чат с той же заявкой. */
  const LOCK_MS = 3000;

  document.querySelectorAll<HTMLFormElement>('[data-lead-form]').forEach((form, i) => {
    const error = form.querySelector<HTMLElement>('[data-error]')!;
    const contact = form.querySelector<HTMLInputElement>('[name="contact"]');
    // Ошибка связана с полем контакта — читалка озвучит её при фокусе.
    error.id ||= `lead-error-${i + 1}`;
    contact?.setAttribute('aria-describedby', error.id);
    const done = form.querySelector<HTMLElement>('[data-done]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const noContactText = error.textContent ?? '';
    const fail = (text: string, field?: HTMLInputElement | null) => {
      error.textContent = text;
      error.hidden = false;
      field?.setAttribute('aria-invalid', 'true');
    };
    const ok = () => {
      error.hidden = true;
      contact?.removeAttribute('aria-invalid');
    };
    contact?.addEventListener('input', () => {
      if (contact.value.trim() && contact.hasAttribute('aria-invalid')) ok();
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
      const value = data.contact?.trim() ?? '';
      if (!value) {
        fail(noContactText, contact);
        contact?.focus();
        return;
      }
      // Похоже на номер (нет букв и @) — в нём должно быть хотя бы 7 цифр.
      // Почту и ник в Telegram пропускаем как есть.
      if (!/[@a-zа-яё]/i.test(value) && value.replace(/\D/g, '').length < 7) {
        fail(form.dataset.shortPhone!, contact);
        contact?.focus();
        return;
      }
      if (submit.disabled) return;
      ok();
      const url = sendLead(data);
      wireDone(done, data, url);
      done.hidden = false;
      submit.disabled = true;
      window.setTimeout(() => {
        submit.disabled = false;
        submit.textContent = form.dataset.again!;
      }, LOCK_MS);
    });
  });
</script>
<style>
  /* Ссылка в тексте отличается не только цветом — подчёркиванием (контраст с текстом рядом мал). */
  .lead__privacy {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .lead {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 64px;
    align-items: start;
  }
  .lead__sub {
    margin-top: 14px;
    color: var(--muted);
  }
  .lead__contacts {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin: 32px 0;
  }
  .lead__contacts li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .lead__contacts li > :global(svg) {
    margin-top: 4px;
    color: var(--accent);
  }
  .lead__contacts li div {
    display: flex;
    flex-direction: column;
    font-weight: 600;
  }
  .lead__contacts a {
    color: var(--ink);
  }
  /* Номер целиком на одной строке и зона касания 44px. */
  .lead__phone {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-block: -8px;
    white-space: nowrap;
  }
  .lead__form {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 32px;
  }
  /* Строка доверия под кнопкой: тихо, без лишнего веса. */
  .lead__trust {
    margin-top: -8px;
    color: var(--muted);
  }
  .lead__error {
    color: var(--warn);
    font-size: 14px;
    line-height: 20px;
  }
  /* «необязательно» рядом с подписью поля — тише самой подписи. */
  .field__opt {
    margin-left: 4px;
    color: var(--muted);
    font-weight: 400;
  }
  @media (max-width: 860px) {
    /* minmax(0, …): длинное слово в заголовке не распирает колонку шире экрана. */
    .lead {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
    .lead__info :global(.h2) {
      overflow-wrap: break-word;
      hyphens: auto;
    }
    .lead__form {
      padding: 22px;
    }
  }
  /* Форма на тёмной сцене: левая колонка светлая. */
  :global(.stage) .lead__info {
    color: var(--on-stage);
  }
  :global(.stage) .lead__sub,
  :global(.stage) .lead__info :global(.caption) {
    color: var(--on-stage-muted);
  }
  :global(.stage) .lead__contacts a,
  :global(.stage) .lead__contacts span {
    color: var(--on-stage);
  }
  :global(.stage) .lead__contacts li > :global(svg) {
    color: var(--olive-pastel);
  }
  :global(.stage) .lead__info :global(.btn--ghost) {
    border-color: var(--stage-line);
    color: var(--on-stage);
  }
</style>
