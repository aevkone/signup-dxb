---
import Icon from './Icon.astro';
import { getLang, link } from '@/i18n';
import { ui } from '@/i18n/ui';
import { CONTACTS, local } from '@/consts';

interface Props {
  title?: string;
  /** Подставляется в поле «Задача», когда форма стоит на странице услуги. */
  context?: string;
}
const lang = getLang(Astro.url);
const t = ui(lang);
const L = local(lang);
const { title = t.leadTitle, context } = Astro.props;
---

<div class="lead">
  <div class="lead__info">
    <h2 class="h2">{title}</h2>
    <p class="lead__sub">{t.leadSub(L.replyTime)}</p>
    <ul class="lead__contacts">
      <li>
        <Icon name="phone" size={20} />
        <div>
          <span class="caption">{t.phoneWa}</span>
          <a href={CONTACTS.phoneHref}>{CONTACTS.phone}</a>
        </div>
      </li>
      <li>
        <Icon name="clock" size={20} />
        <div>
          <span class="caption">{t.hours}</span>
          <span>{L.hours}</span>
        </div>
      </li>
    </ul>
    <a class="btn btn--ghost" href={CONTACTS.whatsapp} target="_blank" rel="noopener">
      <Icon name="whatsapp" size={20} /> {t.whatsapp}
    </a>
  </div>

  <form
    class="lead__form card"
    data-lead-form
    data-submit={t.submit}
    data-sending={t.sending}
    data-attach-big={t.attachBig}
    data-attach-wa={t.attachWa}
    data-attach-hint={t.attachHint}
    novalidate
  >
    <label class="field">
      <span>{t.name}</span>
      <input class="input" name="name" autocomplete="name" placeholder={t.namePh} />
    </label>
    <label class="field">
      <span>{t.contact}</span>
      <input class="input" name="contact" type="tel" autocomplete="tel" placeholder="+971" required />
    </label>
    <label class="field">
      <span>{t.task}</span>
      <textarea class="textarea" name="task" rows="3" placeholder={t.taskPh}>{context}</textarea>
    </label>
    <div class="field">
      <span>{t.attach}</span>
      <label class="attach" data-attach>
        <input
          type="file"
          name="file"
          class="visually-hidden"
          data-file
          accept=".pdf,.png,.jpg,.jpeg,.webp,.svg,.ai,.eps,.psd,.cdr,.zip,.rar,image/*,application/pdf"
        />
        <span class="attach__btn">{t.attachPick}</span>
        <span class="attach__name caption" data-file-name>{t.attachHint}</span>
      </label>
      <button type="button" class="attach__drop caption" data-file-drop hidden>{t.attachDrop}</button>
    </div>
    <p class="lead__error" data-error hidden>{t.noContact}</p>
    <button class="btn btn--primary" type="submit">{t.submit}</button>
    <p class="caption">
      {t.consent} <a href={link('/privacy/', lang)}>{t.consentLink}</a>.
    </p>
    <div class="lead__done" data-done hidden>
      <Icon name="check" size={28} />
      <div>
        <strong>{t.sent}</strong>
        <p class="caption">{t.sentText(L.replyTime)}</p>
      </div>
    </div>
  </form>
</div>

<script>
  import { MAX_FILE_BYTES, sendLead } from '@/scripts/lead';

  document.querySelectorAll<HTMLFormElement>('[data-lead-form]').forEach((form) => {
    const error = form.querySelector<HTMLElement>('[data-error]')!;
    const done = form.querySelector<HTMLElement>('[data-done]')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const fileInput = form.querySelector<HTMLInputElement>('[data-file]');
    const fileName = form.querySelector<HTMLElement>('[data-file-name]');
    const fileDrop = form.querySelector<HTMLButtonElement>('[data-file-drop]');
    /** Исходный текст ошибки про контакт — его затирают сообщения о файле. */
    const noContactText = error.textContent ?? '';
    const fail = (text: string) => {
      error.textContent = text;
      error.hidden = false;
    };

    const clearFile = () => {
      if (!fileInput) return;
      fileInput.value = '';
      if (fileName) fileName.textContent = form.dataset.attachHint!;
      if (fileDrop) fileDrop.hidden = true;
    };

    fileInput?.addEventListener('change', () => {
      const f = fileInput.files?.[0];
      if (!f) return clearFile();
      if (f.size > MAX_FILE_BYTES) {
        fail(form.dataset.attachBig!);
        clearFile();
        return;
      }
      error.hidden = true;
      const mb = (f.size / 1024 / 1024).toFixed(1);
      if (fileName) fileName.textContent = `${f.name} · ${mb} МБ`;
      if (fileDrop) fileDrop.hidden = false;
    });

    fileDrop?.addEventListener('click', clearFile);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const file = fileInput?.files?.[0] ?? null;
      fd.delete('file');
      const data = Object.fromEntries(fd) as Record<string, string>;
      if (!data.contact?.trim()) {
        fail(noContactText);
        form.querySelector<HTMLInputElement>('[name="contact"]')?.focus();
        return;
      }
      error.hidden = true;
      btn.disabled = true;
      btn.textContent = form.dataset.sending!;
      const how = await sendLead(data, file);
      btn.disabled = false;
      btn.textContent = form.dataset.submit!;
      if (how === 'sent') {
        form.reset();
        clearFile();
        done.hidden = false;
      } else if (file) {
        // WhatsApp открывается ссылкой — файл туда не уедет, просим приложить.
        fail(form.dataset.attachWa!);
      }
    });
  });
</script>
<style>
  .attach {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    cursor: pointer;
  }
  .attach__btn {
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding-inline: 22px;
    border: 1px solid var(--line);
    border-radius: var(--pill);
    font-size: 15px;
    font-weight: 600;
    white-space: nowrap;
    transition: border-color 0.18s ease;
  }
  .attach:hover .attach__btn {
    border-color: var(--ink);
  }
  .attach input:focus-visible + .attach__btn {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .attach__name {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .attach__drop {
    align-self: flex-start;
    margin-top: 8px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--accent);
    font: inherit;
    font-size: 14px;
    text-decoration: underline;
    cursor: pointer;
  }
  .lead {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 64px;
    align-items: start;
  }
  .lead__sub {
    margin-top: 14px;
    color: var(--muted);
  }
  .lead__contacts {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin: 32px 0;
  }
  .lead__contacts li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .lead__contacts li > :global(svg) {
    margin-top: 4px;
    color: var(--accent);
  }
  .lead__contacts li div {
    display: flex;
    flex-direction: column;
    font-weight: 600;
  }
  .lead__contacts a {
    color: var(--ink);
  }
  .lead__form {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 32px;
  }
  .lead__error {
    color: var(--warn);
    font-size: 14px;
    line-height: 20px;
  }
  .lead__done {
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 16px;
    border-radius: var(--radius-sm);
    background: #eef4f0;
    color: var(--ok);
  }
  .lead__done strong {
    color: var(--ink);
  }
  @media (max-width: 860px) {
    .lead {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .lead__form {
      padding: 22px;
    }
  }
</style>
