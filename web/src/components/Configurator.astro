---
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';
import { getLang } from '@/i18n';
import { ui } from '@/i18n/ui';
import { CONTACTS, local } from '@/consts';

const lang = getLang(Astro.url);
const c = ui(lang).cfg;
const L = local(lang);
const ICONS: IconName[] = ['talks', 'stand', 'light', 'print', 'staff', 'concierge'];

/** Строки для клиентского скрипта. */
const i18n = {
  labels: c.labels,
  step: c.step(0),
  done: c.done,
  next: c.next,
  submit: c.submit,
  sending: c.sending,
  needService: c.needService,
  needContact: c.needContact,
};
---

<div class="cfg" data-cfg data-i18n={JSON.stringify(i18n)}>
  <div class="cfg__main card">
    <div class="cfg__progress" data-progress>
      <span class="caption" data-step-label>{c.step(1)}</span>
      <span class="cfg__bar"><span data-bar></span></span>
    </div>

    <fieldset class="cfg__step" data-step="1">
      <legend class="visually-hidden">{c.s1}</legend>
      <div class="cfg__head" aria-hidden="true">
        <p class="h3">{c.s1}</p>
        <p class="caption">{c.s1sub}</p>
      </div>
      <div class="cfg__tiles">
        {
          c.services.map((label, i) => (
            <label class="tile">
              <input type="radio" name="service" value={label} />
              <Icon name={ICONS[i]} size={26} />
              <span>{label}</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <fieldset class="cfg__step" data-step="2" hidden>
      <legend class="visually-hidden">{c.s2}</legend>
      <div class="cfg__head" aria-hidden="true">
        <p class="h3">{c.s2}</p>
        <p class="caption">{c.s2sub}</p>
      </div>
      <label class="field">
        <span>{c.expo}</span>
        <input class="input" name="expo" placeholder={c.expoPh} />
      </label>
      <div class="field">
        <span>{c.area}</span>
        <div class="pills">
          {
            L.areas.map((a) => (
              <label class="pill">
                <input type="radio" name="area" value={a} />
                <span>{a}</span>
              </label>
            ))
          }
        </div>
      </div>
      <label class="field">
        <span>{c.dates}</span>
        <input class="input" name="dates" placeholder={c.datesPh} />
      </label>
    </fieldset>

    <fieldset class="cfg__step" data-step="3" hidden>
      <legend class="visually-hidden">{c.s3}</legend>
      <div class="cfg__head" aria-hidden="true">
        <p class="h3">{c.s3}</p>
        <p class="caption">{c.s3sub}</p>
      </div>
      <div class="field">
        <span>{c.budget}</span>
        <div class="pills">
          {
            L.budgets.map((b) => (
              <label class="pill">
                <input type="radio" name="budget" value={b} />
                <span>{b}</span>
              </label>
            ))
          }
        </div>
      </div>
      <div class="grid grid--2">
        <label class="field">
          <span>{ui(lang).name}</span>
          <input class="input" name="name" autocomplete="name" placeholder={ui(lang).namePh} />
        </label>
        <label class="field">
          <span>{ui(lang).contact}</span>
          <input class="input" name="contact" type="tel" autocomplete="tel" placeholder="+971" />
        </label>
      </div>
    </fieldset>

    <div class="cfg__step cfg__done" data-step="4" hidden>
      <span class="cfg__done-icon"><Icon name="check" size={30} /></span>
      <h3 class="h3">{c.doneTitle}</h3>
      <p class="caption">{c.doneText(L.replyTime)}</p>
    </div>

    <p class="cfg__hint" data-hint hidden></p>

    <div class="cfg__nav" data-nav>
      <button type="button" class="btn btn--ghost" data-back hidden>{c.back}</button>
      <button type="button" class="btn btn--primary" data-next>{c.next}</button>
      <a class="cfg__wa" href={CONTACTS.whatsapp} target="_blank" rel="noopener">
        <Icon name="whatsapp" size={18} /> {c.preferWa}
      </a>
    </div>
  </div>

  <aside class="cfg__summary card" aria-live="polite">
    <div class="eyebrow">{c.summary}</div>
    <dl data-summary></dl>
    <p class="caption">{c.summaryNote(L.minOrder)}</p>
  </aside>
</div>

<script>
  import { sendLead } from '@/scripts/lead';

  type Strings = {
    labels: Record<string, string>;
    step: string;
    done: string;
    next: string;
    submit: string;
    sending: string;
    needService: string;
    needContact: string;
  };

  const ORDER = ['service', 'expo', 'area', 'dates', 'budget', 'name', 'contact'];
  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');

  document.querySelectorAll<HTMLElement>('[data-cfg]').forEach((root) => {
    const S = JSON.parse(root.dataset.i18n!) as Strings;
    const stepText = (n: number) => S.step.replace('0', String(n));
    let step = 1;
    const steps = root.querySelectorAll<HTMLElement>('[data-step]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const back = root.querySelector<HTMLButtonElement>('[data-back]')!;
    const nav = root.querySelector<HTMLElement>('[data-nav]')!;
    const hint = root.querySelector<HTMLElement>('[data-hint]')!;
    const bar = root.querySelector<HTMLElement>('[data-bar]')!;
    const label = root.querySelector<HTMLElement>('[data-step-label]')!;
    const summary = root.querySelector<HTMLElement>('[data-summary]')!;

    const values = () => {
      const out: Record<string, string> = {};
      root.querySelectorAll<HTMLInputElement>('input').forEach((el) => {
        if ((el.type === 'radio' && el.checked) || (el.type !== 'radio' && el.value.trim())) out[el.name] = el.value.trim();
      });
      return out;
    };

    const problem = (v: Record<string, string>) =>
      step === 1 && !v.service ? S.needService : step === 3 && !v.contact ? S.needContact : '';

    const render = () => {
      const v = values();
      steps.forEach((el) => (el.hidden = Number(el.dataset.step) !== step));
      back.hidden = step === 1 || step === 4;
      nav.hidden = step === 4;
      next.textContent = step === 3 ? S.submit : S.next;
      next.setAttribute('aria-disabled', String(Boolean(problem(v))));
      label.textContent = step === 4 ? S.done : stepText(step);
      bar.style.width = `${(Math.min(step, 3) / 3) * 100}%`;
      summary.innerHTML = ORDER.map((k) => `<div><dt>${S.labels[k]}</dt><dd>${esc(v[k] ?? '—')}</dd></div>`).join('');
      if (!problem(v)) hint.hidden = true;
    };

    root.addEventListener('input', render);
    root.addEventListener('change', render);

    back.addEventListener('click', () => {
      step = Math.max(1, step - 1);
      render();
    });

    next.addEventListener('click', async () => {
      const v = values();
      const p = problem(v);
      if (p) {
        hint.textContent = p;
        hint.hidden = false;
        return;
      }
      if (step < 3) {
        step += 1;
        render();
        root.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        return;
      }
      next.disabled = true;
      next.textContent = S.sending;
      const how = await sendLead(v);
      next.disabled = false;
      if (how === 'sent') step = 4;
      render();
    });

    render();
  });
</script>
<style>
  .cfg {
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    gap: 24px;
    align-items: start;
  }
  .cfg__main {
    padding: 36px;
    min-height: 520px;
    display: flex;
    flex-direction: column;
  }
  .cfg__progress {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 28px;
  }
  .cfg__bar {
    flex: 1;
    height: 4px;
    background: var(--line);
    border-radius: 2px;
    overflow: hidden;
  }
  .cfg__bar span {
    display: block;
    height: 100%;
    background: var(--olive);
    transition: width 0.3s ease;
  }
  .cfg__step {
    border: 0;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
    flex: 1;
  }
  .cfg__head .caption {
    margin-top: 6px;
  }
  .cfg__tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .tile {
    position: relative;
    min-height: 112px;
    padding: 18px;
    border: 1.5px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    font-weight: 600;
    cursor: pointer;
    color: var(--accent);
    transition: border-color 0.18s ease, background-color 0.18s ease;
  }
  .tile span {
    color: var(--ink);
  }
  .tile:hover {
    border-color: #cfcbc3;
  }
  .tile:has(input:checked) {
    border-color: var(--accent);
    background: #f4f5f8;
  }
  .tile input,
  .pill input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .tile:has(input:focus-visible),
  .pill:has(input:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .pill {
    position: relative;
    height: 44px;
    padding: 0 18px;
    border: 1.5px solid var(--line);
    border-radius: 100px;
    background: var(--surface);
    display: inline-flex;
    align-items: center;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
  }
  .pill:has(input:checked) {
    border-color: var(--accent);
    background: #f4f5f8;
  }
  .cfg__done {
    align-items: flex-start;
    justify-content: center;
  }
  .cfg__done-icon {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #eef4f0;
    color: var(--ok);
  }
  .cfg__hint {
    margin-top: 16px;
    color: #8a6a55;
    font-size: 14px;
  }
  .cfg__nav {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 28px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .cfg__nav .btn[aria-disabled='true'] {
    background: #b9bcc2;
  }
  .cfg__wa {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
  }
  .cfg__summary {
    position: sticky;
    top: 112px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .cfg__summary :global(dl) {
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .cfg__summary :global(dl > div) {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 11px 0;
    border-bottom: 1px solid var(--line);
    font-size: 15px;
  }
  .cfg__summary :global(dt) {
    color: var(--muted);
  }
  .cfg__summary :global(dd) {
    margin: 0;
    font-weight: 600;
    text-align: right;
  }
  @media (max-width: 960px) {
    .cfg {
      grid-template-columns: 1fr;
    }
    .cfg__summary {
      position: static;
    }
  }
  @media (max-width: 640px) {
    .cfg__main {
      padding: 22px;
      min-height: 0;
    }
    .cfg__tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .cfg__nav .btn {
      flex: 1;
    }
    .cfg__wa {
      margin-left: 0;
      width: 100%;
      justify-content: center;
    }
  }
</style>
