---
/**
 * Вариант А первого экрана: «Стенд собирается сам», 3D.
 * Островной стенд 48 м²: логистика → пол → модульные стены → подсобка →
 * ферма с прожекторами → печать, LED-экран, подвесной баннер → мебель →
 * персонал и посетители → демонтаж. Камера подлетает, облетает стенд и отлетает.
 * Сцену рисует scripts/hero-stand.ts на Canvas 2D; чек-лист и этапы — SVG поверх.
 */
import { getLang, link } from '@/i18n';
import { process } from '@/data/process';

const lang = getLang(Astro.url);
/** Реальные фото работ: слайдшоу на LED-экране стенда; последнее — на печати задней стены. */
const POSTER = lang === 'en' ? 'stand-en-2' : 'stand-2';
const PHOTOS = ['27', '17', '24', '36', '50', '20'].map((id) => link(`/img/works/w${id}-600.jpg`));
const STEPS = process(lang);
const T = {
  ru: {
    area: '48 м²',
    w: '8 м',
    d: '6 м',
    script: 'под ключ',
    pause: 'Остановить анимацию',
    play: 'Запустить анимацию',
  },
  en: {
    area: '48 m²',
    w: '8 m',
    d: '6 m',
    script: 'turnkey',
    pause: 'Pause animation',
    play: 'Play animation',
  },
}[lang];
/** Подписи внизу — все шесть этапов из схемы работы, по порядку. */
const CAPS: [number, string][] = STEPS.map((s, i) => [i + 1, s.title]);
---

<div
  class="hs"
  data-hero-stand
  data-area={T.area}
  data-w={T.w}
  data-d={T.d}
  data-script={T.script}
  data-photos={JSON.stringify(PHOTOS)}
>
  <!-- Кадр стенда, пока 3D готовится: место под сцену не пустует. -->
  <picture class="hs__poster" aria-hidden="true">
    <source type="image/webp" srcset={`${link(`/img/stand/${POSTER}-800.webp`)} 800w, ${link(`/img/stand/${POSTER}-1600.webp`)} 1600w`} sizes="(max-width: 1080px) 100vw, 900px" />
    <img src={link(`/img/stand/${POSTER}-800.jpg`)} width="800" height="600" alt="" decoding="async" fetchpriority="high" />
  </picture>
  <canvas class="hs__canvas" aria-hidden="true"></canvas>
  <svg class="hs__svg" viewBox="0 0 560 560" width="560" height="560" aria-hidden="true">


    <!-- Этап из схемы работы -->
    {
      CAPS.map(([n, title]) => (
        <g class="hs__cap" data-cap transform="translate(22 514)">
          <circle cx="14" cy="14" r="14"></circle>
          <text class="hs__cap-n" x="14" y="19" text-anchor="middle">{n}</text>
          <text class="hs__cap-t" x="38" y="19">{title}</text>
        </g>
      ))
    }
  </svg>
  <button class="hs__pp" type="button" data-hm-toggle data-label-pause={T.pause} data-label-play={T.play} aria-label={T.pause} hidden>
    <svg class="hs__pp-pause" viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><rect x="6" y="5" width="4" height="14" rx="1"></rect><rect x="14" y="5" width="4" height="14" rx="1"></rect></svg>
    <svg class="hs__pp-play" viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M7 4.5v15l12.5-7.5z"></path></svg>
  </button>
</div>

<style>
  .hs {
    position: relative;
    width: 100%;
    max-width: 620px;
    aspect-ratio: 1 / 1;
    justify-self: end;
  }
  /* Края сцены мягко растворяются в фоне по эллипсу — без рамки и обрыва. */
  .hs__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.6s ease;
    -webkit-mask-image: radial-gradient(ellipse 50% 50% at 50% 48%, #000 38%, rgb(0 0 0 / 0.85) 50%, rgb(0 0 0 / 0.55) 64%, rgb(0 0 0 / 0.25) 80%, rgb(0 0 0 / 0.08) 92%, transparent 100%);
    mask-image: radial-gradient(ellipse 50% 50% at 50% 48%, #000 38%, rgb(0 0 0 / 0.85) 50%, rgb(0 0 0 / 0.55) 64%, rgb(0 0 0 / 0.25) 80%, rgb(0 0 0 / 0.08) 92%, transparent 100%);
  }
  .hs.is-ready .hs__canvas {
    opacity: 1;
  }
  .hs__poster {
    position: absolute;
    inset: 12% 4% 14%;
    transition: opacity 0.6s ease;
    -webkit-mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, #000 55%, transparent 100%);
    mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, #000 55%, transparent 100%);
  }
  .hs__poster img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .hs.is-ready .hs__poster {
    opacity: 0;
  }
  /* Подписи появляются вместе со сценой, а не над пустым местом. */
  .hs__svg {
    transition: opacity 0.6s ease;
  }
  .hs:not(.is-ready) .hs__svg {
    opacity: 0;
  }
  .hs__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    font-family: inherit;
    user-select: none;
  }
  .hs__cap circle {
    fill: #d2d8a8;
  }
  .hs__cap-n {
    font-size: 14px;
    font-weight: 800;
    fill: #0f100d;
  }
  .hs__cap-t {
    font-size: 16px;
    font-weight: 700;
    fill: #f2f2ec;
  }
  .hs__pp {
    position: absolute;
    right: 8px;
    bottom: 8px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--stage-line);
    background: rgb(15 16 13 / 0.6);
    color: var(--on-stage-muted);
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .hs__pp:hover {
    color: var(--olive-pastel);
    border-color: var(--olive-pastel);
  }
  .hs__pp:focus-visible {
    outline: 2px solid var(--olive-pastel);
    outline-offset: 3px;
  }
  .hs__pp-play,
  .hs[data-paused] .hs__pp-pause {
    display: none;
  }
  .hs[data-paused] .hs__pp-play {
    display: block;
  }
  /* На компьютере сцена в 1,5 раза больше колонки: подпись и пауза — в видимой части. */
  @media (min-width: 1081px) {
    .hs__pp {
      right: 27%;
      bottom: 24%;
    }
    .hs__cap-t {
      font-size: 11px;
    }
    .hs__cap-n {
      font-size: 10px;
    }
    .hs__cap circle {
      r: 10;
      cy: 15;
    }
  }
  @media (max-width: 1080px) {
    .hs {
      justify-self: center;
      max-width: 540px;
    }
  }
  /* На телефоне подпись этапа крупнее. */
  @media (max-width: 600px) {
    .hs__cap-t {
      font-size: 24px;
    }
    .hs__cap-n {
      font-size: 18px;
    }
    .hs__cap circle {
      r: 17;
    }
  }
</style>

<script>
  import '@/scripts/hero-stand';
</script>
