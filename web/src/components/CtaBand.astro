---
import Icon from './Icon.astro';
import { getLang, link } from '@/i18n';
import { ui } from '@/i18n/ui';
import { local, waLink } from '@/consts';

interface Props {
  title?: string;
  text?: string;
}
const lang = getLang(Astro.url);
const t = ui(lang);
const { title = t.bandTitle, text = t.bandText(local(lang).minOrder) } = Astro.props;
---

<section class="section--tight">
  <div class="shell">
    <div class="band">
      <div>
        <h2 class="h2">{title}</h2>
        <p class="band__text">{text}</p>
      </div>
      <div class="band__actions">
        <a class="btn btn--primary" href={link('/configurator/', lang)}>{t.calc}</a>
        <a class="btn btn--ghost" href={waLink(lang)} target="_blank" rel="noopener">
          <Icon name="whatsapp" size={20} /> {t.whatsapp}
        </a>
      </div>
    </div>
  </div>
</section>
<style>
  .band {
    background: var(--lime);
    border-radius: var(--radius);
    padding: 44px 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }
  .band__text {
    margin-top: 10px;
    color: #4a4e55;
    max-width: 560px;
  }
  .band__actions {
    display: flex;
    gap: 12px;
    flex-shrink: 0;
  }
  @media (max-width: 860px) {
    .band {
      flex-direction: column;
      align-items: stretch;
      padding: 28px 22px;
    }
    .band__actions {
      flex-direction: column;
    }
  }
  /* 320px: поля уже — чтобы «Message on WhatsApp» на кнопке не переносился. */
  @media (max-width: 360px) {
    .band {
      padding: 24px 14px;
    }
  }
</style>
