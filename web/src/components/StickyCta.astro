---
/**
 * Нижняя панель действий на телефоне: WhatsApp и заявка.
 * Видна только до 760px — с загрузки, если главной кнопки первого экрана
 * не видно (на низком телефоне она ниже сгиба). Прячется, пока на экране
 * эта кнопка, расчёт на главной, форма заявки или подвал, и пока открыто
 * мобильное меню. На странице расчёта не выводится — там кнопка вела бы
 * на ту же страницу и закрывала бы её итог.
 *
 * Здесь же — подстановка текста в ссылки WhatsApp по всему сайту
 * (компонент стоит в подвале, значит, есть на каждой странице).
 */
import Icon from './Icon.astro';
import { getLang, link, splitPath } from '@/i18n';
import { ui } from '@/i18n/ui';
import { waLink } from '@/consts';

const lang = getLang(Astro.url);
const t = ui(lang);
const { path } = splitPath(Astro.url.pathname);
const onConfigurator = path.startsWith('/configurator');
---

{
  !onConfigurator && (
    <div class="scta" data-sticky-cta inert>
      <div class="scta__row">
        <a class="scta__wa" href={waLink(lang)} data-wa-page target="_blank" rel="noopener" aria-label={t.whatsapp}>
          <Icon name="whatsapp" size={20} />
          <span translate="no">WhatsApp</span>
        </a>
        <a class="btn btn--primary scta__cta" href={link('/configurator/', lang)}>
          {t.calc}
        </a>
      </div>
    </div>
  )
}

<script>
  import { waText } from '@/consts';

  /**
   * Ссылки на WhatsApp без готового текста получают первое сообщение
   * с названием страницы — так мы сразу видим, откуда человек пишет.
   * Общие ссылки шапки, подвала и панели (data-wa-page) собраны с текстом
   * без страницы — им название страницы дописывается здесь же.
   * На главной заголовок — слоган, поэтому там текст без контекста.
   */
  {
    const lang = document.documentElement.lang === 'en' ? 'en' : 'ru';
    const h1 = document.querySelector('h1');
    const context = h1 && !h1.closest('.hero') ? h1.textContent ?? '' : '';
    document.querySelectorAll<HTMLAnchorElement>('a[href^="https://wa.me/"]').forEach((a) => {
      const [base, query = ''] = a.href.split('?');
      const hasText = new URLSearchParams(query).has('text');
      if (hasText && !(a.hasAttribute('data-wa-page') && context)) return;
      // Пробелы — как %20, а не «+»: так текст надёжно читается в WhatsApp.
      a.href = `${base}?text=${encodeURIComponent(waText(lang, context))}`;
    });
  }

  const bar = document.querySelector<HTMLElement>('[data-sticky-cta]');
  if (bar) {
    const mq = window.matchMedia('(max-width: 760px)');
    /** Что сейчас на экране из того, что панель не должна закрывать или дублировать. */
    const covering = new Set<Element>();
    /** До первого ответа наблюдателя положение неизвестно — панель не дёргаем. */
    let ready = false;

    const update = () => {
      if (!ready) return;
      const menuOpen = document.documentElement.classList.contains('mnav-open');
      const show = mq.matches && covering.size === 0 && !menuOpen;
      bar.classList.toggle('is-on', show);
      // Спрятанная панель не должна ловить фокус и касания.
      bar.inert = !show;
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) covering.add(e.target);
          else covering.delete(e.target);
        }
        ready = true;
        update();
      },
      // Уходит, как только кнопка первого экрана, расчёт, форма или подвал показались на экране.
      { threshold: 0 },
    );
    document
      .querySelectorAll('.hero__cta, .phero .btn--primary, #calc, #lead, [data-lead-form], .ftr')
      .forEach((el) => io.observe(el));

    // Меню в шапке ставит на <html> класс mnav-open.
    new MutationObserver(update).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
    mq.addEventListener('change', update);
  }
</script>

<style>
  .scta {
    display: none;
  }
  @media (max-width: 760px) {
    .scta {
      display: block;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 40;
      padding: 10px var(--gutter) calc(10px + env(safe-area-inset-bottom));
      background: rgb(15 16 13 / 0.96);
      backdrop-filter: saturate(1.2) blur(10px);
      border-top: 1px solid var(--stage-line);
      transform: translateY(105%);
      visibility: hidden;
      /* Уходит быстрее, чем выезжает: система отвечает — значит, быстро. */
      transition:
        transform 0.22s cubic-bezier(0.32, 0.72, 0, 1),
        visibility 0s linear 0.22s;
    }
    .scta.is-on {
      transform: none;
      visibility: visible;
      transition:
        transform 0.36s cubic-bezier(0.32, 0.72, 0, 1),
        visibility 0s;
    }
  }
  @media (max-width: 760px) and (prefers-reduced-motion: reduce) {
    /* Без выезда: панель просто появляется и исчезает. */
    .scta,
    .scta.is-on {
      transform: none;
      transition: none;
    }
  }
  .scta__row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 10px;
  }
  .scta__wa,
  .scta__cta {
    height: 56px;
    font-size: 15px;
    white-space: nowrap;
  }
  .scta__wa {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding-inline: 18px;
    border: 1px solid var(--olive-pastel);
    border-radius: var(--pill);
    color: var(--olive-pastel);
    font-weight: 600;
    transition:
      background-color 0.18s ease,
      color 0.18s ease,
      transform 0.16s var(--ease-out);
    touch-action: manipulation;
  }
  .scta__wa:hover {
    background: var(--olive-pastel);
    color: var(--stage);
  }
  .scta__wa:active {
    background: var(--olive-pastel);
    color: var(--stage);
    transform: scale(0.97);
  }
  .scta__cta {
    padding-inline: 16px;
    min-width: 0;
  }
  /* На совсем узких экранах у WhatsApp остаётся только значок. */
  @media (max-width: 350px) {
    .scta__wa {
      width: 56px;
      padding: 0;
    }
    .scta__wa span {
      display: none;
    }
  }
</style>
