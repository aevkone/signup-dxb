---
import { getLang, link } from '@/i18n';
import { ui } from '@/i18n/ui';

interface Props {
  title: string;
  lead?: string;
  crumbs?: { href?: string; label: string }[];
}
const { title, lead, crumbs = [] } = Astro.props;
const lang = getLang(Astro.url);
const t = ui(lang);
---

<section class="phero stage">
  <div class="shell">
    {
      crumbs.length > 0 && (
        <nav class="crumbs caption" aria-label={t.breadcrumbs}>
          <a href={link('/', lang)}>{t.home}</a>
          {crumbs.map((c) => (
            <>
              <span aria-hidden="true">/</span>
              {c.href ? <a href={link(c.href, lang)}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
            </>
          ))}
        </nav>
      )
    }
    <h1 class="h1 phero__title">{title}</h1>
    {lead && <p class="lead measure phero__lead">{lead}</p>}
    <slot />
  </div>
</section>
<style>
  /* Шапка внутренних страниц — та же тёмная сцена со сливовым свечением. */
  .phero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: 56px 64px;
  }
  .phero::before {
    content: '';
    position: absolute;
    inset: 40% -10% -60% 30%;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(89 51 95 / 0.7), transparent);
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    color: var(--on-stage-muted);
  }
  .crumbs a {
    color: var(--on-stage-muted);
  }
  .crumbs a:hover {
    color: var(--olive-pastel);
  }
  .phero__title {
    margin-top: 22px;
    max-width: 900px;
    color: #fff;
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .phero__lead {
    margin-top: 18px;
  }
  .phero :global(a:not(.btn):not(.crumbs a)) {
    color: var(--plum-bright);
  }
  @media (max-width: 860px) {
    .phero {
      padding-block: 36px 44px;
    }
  }
</style>
