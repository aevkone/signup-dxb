---
/**
 * Сетка фотографий работ. Список передаётся снаружи: главная берёт
 * избранные, страница категории — свои, раздел «Работы» — все.
 * Пустой список — секция не рендерится.
 */
import { getLang, link } from '@/i18n';
import { workTitle, type Work } from '@/data/works';

interface Props {
  title: string;
  sub?: string;
  list: Work[];
  /** Ссылка «смотреть все» под сеткой. */
  more?: { href: string; label: string };
  /** Обернуть в section с отступами (по умолчанию да). */
  bare?: boolean;
}
const { title, sub, list, more, bare = false } = Astro.props;
const lang = getLang(Astro.url);
const img = (id: string, w: number, ext = 'webp') => link(`/img/works/w${id}-${w}.${ext}`);
---

{
  list.length > 0 && (
    <section class:list={[!bare && 'section']}>
      <div class:list={[!bare && 'shell']}>
        <div class="sec-head">
          <div>
            <h2 class="h2">{title}</h2>
            {sub && <p class="measure sec-head__sub">{sub}</p>}
          </div>
          {more && (
            <a class="btn btn--ghost" href={link(more.href, lang)}>
              {more.label}
            </a>
          )}
        </div>
        <ul class="works">
          {list.map((w, i) => (
            <li class="work">
              <a class="work__link" href={img(w.id, 1200)} target="_blank" rel="noopener">
                <picture>
                  <source type="image/webp" srcset={`${img(w.id, 600)} 600w, ${img(w.id, 1200)} 1200w`} sizes="(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 400px" />
                  <img
                    src={img(w.id, 600, 'jpg')}
                    width="600"
                    height="600"
                    loading={i < 3 ? 'eager' : 'lazy'}
                    decoding="async"
                    alt={workTitle(w, lang)}
                  />
                </picture>
              </a>
              <p class="work__cap">{workTitle(w, lang)}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .works {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px 24px;
  }
  .work__link {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--line-soft);
  }
  .work img {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .work__link:hover img {
    transform: scale(1.03);
  }
  .work__cap {
    margin-top: 12px;
    font-size: 15px;
    line-height: 22px;
    font-weight: 600;
  }
  @media (max-width: 1080px) {
    .works {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .works {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
