---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { LANGS, LANG_LABEL, altPath, link, splitPath } from '@/i18n';
import { ui } from '@/i18n/ui';
import { nav, CONTACTS, waLink } from '@/consts';

const { lang, path: rawPath } = splitPath(Astro.url.pathname);
const path = altPath(rawPath);
const t = ui(lang);
const items = nav(lang);
const wa = waLink(lang);
/** В мобильном меню есть место для «Наших работ» — в широкой шапке строка и так на пределе. */
const mItems = [...items.slice(0, -1), { href: '/works/', label: t.works }, ...items.slice(-1)];
const isActive = (href: string) =>
  href === '/exhibitions/'
    ? path.startsWith('/exhibitions/') && !path.startsWith('/exhibitions/concierge/')
    : path.startsWith(href);
---

<header class="hdr">
  <div class="shell hdr__row">
    <a href={link('/', lang)} class="hdr__logo" aria-label={t.homeAria}>
      <Logo width={60} tone="light" />
    </a>

    <nav class="hdr__nav" aria-label={t.mainMenu}>
      {
        items.map((item) => (
          <a href={link(item.href, lang)} class:list={['hdr__link', { 'is-active': isActive(item.href) }]}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hdr__actions">
      <nav class="langs" aria-label={t.language}>
        {
          LANGS.map((l) => (
            <a href={link(path, l)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined} class:list={['langs__a', { 'is-on': l === lang }]}>
              {LANG_LABEL[l]}
            </a>
          ))
        }
      </nav>
      <a class="hdr__wa" href={wa} data-wa-page target="_blank" rel="noopener" aria-label={t.whatsapp}>
        <Icon name="whatsapp" size={22} />
      </a>
      <a class="btn btn--outline-plum hdr__cta" href={link('/configurator/', lang)}>{t.calc}</a>
    </div>

    <details class="mnav">
      <summary class="mnav__toggle" aria-label={t.menu}>
        <Icon name="menu" size={22} class="mnav__open" />
        <Icon name="close" size={22} class="mnav__close" />
      </summary>
      <div class="mnav__panel">
        <nav aria-label={t.mobileMenu}>
          {
            mItems.map((item) => (
              <a href={link(item.href, lang)} class:list={['mnav__link', { 'is-active': isActive(item.href) }]}>
                {item.label}
              </a>
            ))
          }
        </nav>
        <a class="btn btn--primary" href={link('/configurator/', lang)}>{t.calc}</a>
        <a class="btn btn--ghost" href={wa} data-wa-page target="_blank" rel="noopener">
          <Icon name="whatsapp" size={20} /> {t.whatsapp}
        </a>
        <a class="mnav__phone" href={CONTACTS.phoneHref}>{CONTACTS.phone}</a>
        <nav class="langs langs--m" aria-label={t.language}>
          {
            LANGS.map((l) => (
              <a href={link(path, l)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined} class:list={['langs__a', { 'is-on': l === lang }]}>
                {LANG_LABEL[l]}
              </a>
            ))
          }
        </nav>
      </div>
    </details>
  </div>
</header>
<script>
  /**
   * Мобильное меню на <details>: закрывается по Escape, по нажатию на ссылку
   * внутри и при переходе к широкой шапке. Пока оно открыто, на <html>
   * висит класс mnav-open — по нему прячется нижняя панель действий
   * и замирает прокрутка страницы под меню.
   */
  document.querySelectorAll<HTMLDetailsElement>('details.mnav').forEach((menu) => {
    const toggle = menu.querySelector('summary');
    const sync = () => document.documentElement.classList.toggle('mnav-open', menu.open);
    menu.addEventListener('toggle', sync);
    menu.querySelector('.mnav__panel')?.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) menu.open = false;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        toggle?.focus();
      }
    });
    window.matchMedia('(min-width: 1101px)').addEventListener('change', (e) => {
      if (e.matches) menu.open = false;
    });
    sync();
  });
</script>
<style>
  /* Шапка в грамматике образца: чёрная полоса, светлые ссылки, CTA с кантом. */
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(15 16 13 / 0.94);
    backdrop-filter: saturate(1.2) blur(10px);
    border-bottom: 1px solid var(--stage-line);
    color: var(--on-stage);
  }
  .hdr__row {
    height: 84px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }
  .hdr__logo {
    flex-shrink: 0;
    display: block;
  }
  .hdr__nav {
    display: flex;
    gap: 26px;
  }
  .hdr__link {
    position: relative;
    color: var(--on-stage);
    font-size: 15px;
    font-weight: 600;
    white-space: nowrap;
    padding-block: 10px;
  }
  .hdr__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 2px;
    background: var(--olive-pastel);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease-out);
  }
  .hdr__link:hover {
    color: #fff;
  }
  .hdr__link:hover::after,
  .hdr__link.is-active::after {
    transform: scaleX(1);
  }
  .hdr__actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .langs {
    display: flex;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--stage-line);
    border-radius: var(--pill);
  }
  .langs__a {
    position: relative;
    min-width: 38px;
    height: 34px;
    display: grid;
    place-items: center;
    padding: 0 10px;
    border-radius: var(--pill);
    font-size: 13px;
    font-weight: 700;
    color: var(--on-stage-muted);
  }
  /* Зона касания 44px по высоте при визуальной высоте 34px. */
  .langs__a::before {
    content: '';
    position: absolute;
    inset: -5px 0;
  }
  .langs__a:hover {
    color: #fff;
  }
  .langs__a.is-on {
    background: var(--on-stage);
    color: var(--stage);
  }
  .hdr__wa {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid var(--stage-line);
    border-radius: 50%;
    color: var(--on-stage);
    transition: border-color 0.2s ease, color 0.2s ease, transform 0.16s var(--ease-out);
  }
  .hdr__wa:hover {
    border-color: var(--olive-pastel);
    color: var(--olive-pastel);
  }
  .hdr__wa:active,
  .mnav__toggle:active {
    transform: scale(0.94);
  }
  .hdr__cta {
    height: 44px;
    padding-inline: 22px;
    font-size: 14px;
    white-space: nowrap;
  }
  /* Сжатие стоит после базовых правил, иначе они его перебивают.
     1101–1439px: меню целиком, но плотнее (в обычном размере оно влезает
     только с ~1430px — у «Рассчитать стоимость» подпись длиннее) — бургер только ниже 1100px. */
  @media (max-width: 1439px) {
    .hdr__row {
      gap: 20px;
      /* Поле сжимается ровно настолько, чтобы меню влезло: на 1280px шапка
         почти совпадает с сеткой страницы, к 1100px поле — 24px. */
      padding-inline: clamp(24px, calc((100vw - 1110px) / 2), var(--gutter));
    }
    .hdr__nav {
      gap: 18px;
    }
    .hdr__link {
      font-size: 14px;
    }
    .hdr__actions {
      gap: 10px;
    }
    .hdr__cta {
      padding-inline: 18px;
    }
  }
  @media (max-width: 1180px) {
    .hdr__row {
      gap: 16px;
    }
    .hdr__nav {
      gap: 15px;
    }
  }
  /* «Рассчитать стоимость» длиннее прежней подписи — у самого края
     бургера ужимаем промежутки и поля кнопки, чтобы строка не рвалась. */
  @media (max-width: 1140px) {
    .hdr__row {
      gap: 12px;
    }
    .hdr__nav {
      gap: 12px;
    }
    .hdr__actions {
      gap: 8px;
    }
    .hdr__cta {
      padding-inline: 14px;
    }
  }

  .mnav {
    display: none;
  }
  /* Под открытым меню страница не прокручивается; место полосы прокрутки
     сохраняется, чтобы шапка не прыгала в узком окне компьютера. */
  :global(html.mnav-open) {
    overflow: hidden;
    scrollbar-gutter: stable;
  }
  @keyframes mnav-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mnav[open] .mnav__panel {
      animation: none;
    }
  }

  @media (max-width: 1100px) {
    /* Из действий остаётся круглая кнопка WhatsApp рядом с бургером. */
    .hdr__nav,
    .hdr__actions .langs,
    .hdr__cta {
      display: none;
    }
    .hdr__row {
      height: 68px;
      gap: 10px;
      padding-inline: var(--gutter);
    }
    .hdr__actions {
      margin-left: auto;
    }
    .mnav {
      display: block;
    }
    .mnav__toggle {
      list-style: none;
      width: 44px;
      height: 44px;
      display: grid;
      place-items: center;
      border: 1px solid var(--stage-line);
      border-radius: 50%;
      color: var(--on-stage);
      cursor: pointer;
    }
    .mnav__toggle::-webkit-details-marker {
      display: none;
    }
    .mnav :global(.mnav__close),
    .mnav[open] :global(.mnav__open) {
      display: none;
    }
    .mnav[open] :global(.mnav__close) {
      display: block;
    }
    .mnav__panel {
      position: absolute;
      left: 0;
      right: 0;
      top: 68px;
      height: calc(100dvh - 68px);
      overflow-y: auto;
      overscroll-behavior: contain;
      background: var(--stage);
      border-top: 1px solid var(--stage-line);
      padding: 20px var(--gutter) 32px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    /* Меню выезжает коротко и сверху — от кнопки, которая его открыла; закрывается мгновенно. */
    .mnav[open] .mnav__panel {
      animation: mnav-in 0.22s var(--ease-out);
    }
    .mnav__toggle {
      transition: transform 0.16s var(--ease-out);
      touch-action: manipulation;
    }
    /* На низком экране меню прокручивается, а не сплющивает кнопки. */
    .mnav__panel > * {
      flex-shrink: 0;
    }
    .mnav__panel nav {
      display: flex;
      flex-direction: column;
      margin-bottom: 12px;
    }
    .mnav__link {
      color: var(--on-stage);
      font-size: 22px;
      font-weight: 700;
      padding: 14px 0;
      border-bottom: 1px solid var(--stage-line);
    }
    .mnav__link.is-active {
      color: var(--olive-pastel);
    }
    .mnav__phone {
      align-self: flex-start;
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      margin-top: 4px;
      color: var(--on-stage);
      font-weight: 700;
      font-size: 18px;
      white-space: nowrap;
    }
    /* Кнопки меню во всю ширину: подпись в одну строку и на 320px. */
    .mnav__panel :global(.btn) {
      padding-inline: 16px;
      white-space: nowrap;
    }
    .mnav :global(.btn--ghost) {
      color: var(--on-stage);
      border-color: var(--stage-line);
    }
    /* Переключатель языка в меню — в строку, а не столбиком, как остальные nav. */
    .mnav__panel .langs--m {
      flex-direction: row;
      align-self: flex-start;
      margin: 8px 0 0;
    }
    .langs--m .langs__a {
      height: 44px;
      min-width: 56px;
      font-size: 14px;
    }
    .langs--m .langs__a::before {
      content: none;
    }
  }
</style>
