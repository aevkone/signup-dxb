---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { LANGS, LANG_LABEL, altPath, link, splitPath } from '@/i18n';
import { ui } from '@/i18n/ui';
import { nav, CONTACTS } from '@/consts';

const { lang, path: rawPath } = splitPath(Astro.url.pathname);
const path = altPath(rawPath);
const t = ui(lang);
const items = nav(lang);
const isActive = (href: string) =>
  href === '/exhibitions/'
    ? path.startsWith('/exhibitions/') && !path.startsWith('/exhibitions/concierge/')
    : path.startsWith(href);
---

<header class="hdr">
  <div class="shell hdr__row">
    <a href={link('/', lang)} class="hdr__logo" aria-label={t.homeAria}>
      <Logo width={60} tone="light" />
    </a>

    <nav class="hdr__nav" aria-label={t.mainMenu}>
      {
        items.map((item) => (
          <a href={link(item.href, lang)} class:list={['hdr__link', { 'is-active': isActive(item.href) }]}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hdr__actions">
      <nav class="langs" aria-label={t.language}>
        {
          LANGS.map((l) => (
            <a href={link(path, l)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined} class:list={['langs__a', { 'is-on': l === lang }]}>
              {LANG_LABEL[l]}
            </a>
          ))
        }
      </nav>
      <a class="hdr__wa" href={CONTACTS.whatsapp} target="_blank" rel="noopener" aria-label={t.whatsapp}>
        <Icon name="whatsapp" size={22} />
      </a>
      <a class="btn btn--outline-plum hdr__cta" href={link('/configurator/', lang)}>{t.calc}</a>
    </div>

    <details class="mnav">
      <summary class="mnav__toggle" aria-label={t.menu}>
        <Icon name="menu" size={22} class="mnav__open" />
        <Icon name="close" size={22} class="mnav__close" />
      </summary>
      <div class="mnav__panel">
        <nav aria-label={t.mobileMenu}>
          {
            items.map((item) => (
              <a href={link(item.href, lang)} class:list={['mnav__link', { 'is-active': isActive(item.href) }]}>
                {item.label}
              </a>
            ))
          }
        </nav>
        <a class="btn btn--primary" href={link('/configurator/', lang)}>{t.calc}</a>
        <a class="btn btn--ghost" href={CONTACTS.whatsapp} target="_blank" rel="noopener">
          <Icon name="whatsapp" size={20} /> {t.whatsapp}
        </a>
        <a class="mnav__phone" href={CONTACTS.phoneHref}>{CONTACTS.phone}</a>
        <nav class="langs langs--m" aria-label={t.language}>
          {
            LANGS.map((l) => (
              <a href={link(path, l)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined} class:list={['langs__a', { 'is-on': l === lang }]}>
                {LANG_LABEL[l]}
              </a>
            ))
          }
        </nav>
      </div>
    </details>
  </div>
</header>
<style>
  /* Шапка в грамматике образца: чёрная полоса, светлые ссылки, CTA с кантом. */
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(15 16 13 / 0.94);
    backdrop-filter: saturate(1.2) blur(10px);
    border-bottom: 1px solid var(--stage-line);
    color: var(--on-stage);
  }
  .hdr__row {
    height: 84px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }
  .hdr__logo {
    flex-shrink: 0;
    display: block;
  }
  .hdr__nav {
    display: flex;
    gap: 26px;
  }
  .hdr__link {
    position: relative;
    color: var(--on-stage);
    font-size: 15px;
    font-weight: 600;
    white-space: nowrap;
    padding-block: 10px;
  }
  .hdr__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 2px;
    background: var(--olive-pastel);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease-out);
  }
  .hdr__link:hover {
    color: #fff;
  }
  .hdr__link:hover::after,
  .hdr__link.is-active::after {
    transform: scaleX(1);
  }
  .hdr__actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .langs {
    display: flex;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--stage-line);
    border-radius: var(--pill);
  }
  .langs__a {
    min-width: 38px;
    height: 34px;
    display: grid;
    place-items: center;
    padding: 0 10px;
    border-radius: var(--pill);
    font-size: 13px;
    font-weight: 700;
    color: var(--on-stage-muted);
  }
  .langs__a:hover {
    color: #fff;
  }
  .langs__a.is-on {
    background: var(--on-stage);
    color: var(--stage);
  }
  .hdr__wa {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid var(--stage-line);
    border-radius: 50%;
    color: var(--on-stage);
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .hdr__wa:hover {
    border-color: var(--olive-pastel);
    color: var(--olive-pastel);
  }
  .hdr__cta {
    height: 44px;
    padding-inline: 22px;
    font-size: 14px;
    white-space: nowrap;
  }

  .mnav {
    display: none;
  }

  @media (max-width: 1320px) {
    .hdr__nav,
    .hdr__actions {
      display: none;
    }
    .hdr__row {
      height: 68px;
    }
    .mnav {
      display: block;
    }
    .mnav__toggle {
      list-style: none;
      width: 44px;
      height: 44px;
      display: grid;
      place-items: center;
      border: 1px solid var(--stage-line);
      border-radius: 50%;
      color: var(--on-stage);
      cursor: pointer;
    }
    .mnav__toggle::-webkit-details-marker {
      display: none;
    }
    .mnav :global(.mnav__close),
    .mnav[open] :global(.mnav__open) {
      display: none;
    }
    .mnav[open] :global(.mnav__close) {
      display: block;
    }
    .mnav__panel {
      position: absolute;
      left: 0;
      right: 0;
      top: 68px;
      height: calc(100dvh - 68px);
      overflow-y: auto;
      background: var(--stage);
      border-top: 1px solid var(--stage-line);
      padding: 20px var(--gutter) 32px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .mnav__panel nav {
      display: flex;
      flex-direction: column;
      margin-bottom: 12px;
    }
    .mnav__link {
      color: var(--on-stage);
      font-size: 22px;
      font-weight: 700;
      padding: 14px 0;
      border-bottom: 1px solid var(--stage-line);
    }
    .mnav__link.is-active {
      color: var(--olive-pastel);
    }
    .mnav__phone {
      margin-top: 8px;
      color: var(--on-stage);
      font-weight: 700;
      font-size: 18px;
    }
    .mnav :global(.btn--ghost) {
      color: var(--on-stage);
      border-color: var(--stage-line);
    }
    .langs--m {
      align-self: flex-start;
      margin-top: 8px;
    }
  }
</style>
