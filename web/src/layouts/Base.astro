---
// Шрифты — свои файлы в public/fonts (scripts/fonts.py), @font-face ниже в <head>.
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { LANGS, DEFAULT_LANG, altPath, getLang, link, splitPath } from '@/i18n';
import { ui } from '@/i18n/ui';
import { SITE_NAME, CONTACTS, local } from '@/consts';
import { faq } from '@/data/process';

type Crumb = { href?: string; label: string };

interface Props {
  title?: string;
  description?: string;
  /**
   * Хлебные крошки для микроразметки — те же, что у PageHero (без «Главной»).
   * Если не переданы, строятся из заголовка страницы.
   */
  crumbs?: Crumb[];
}

const lang = getLang(Astro.url);
const L = local(lang);
const { title, description = L.siteDescription, crumbs } = Astro.props;
const fullTitle = title ? `${title} — ${SITE_NAME}` : L.siteTitle;
const { path } = splitPath(Astro.url.pathname);
const abs = (l: (typeof LANGS)[number]) => new URL(link(altPath(path), l), Astro.site).href;
const absPath = (p: string) => new URL(link(p, lang), Astro.site).href;

const isHome = path === '/';
const is404 = path.replace(/\/+$/, '') === '/404';

/**
 * Превью на GitHub Pages закрывается от поисковиков мета-тегом: robots.txt
 * там не работает, он читается только из корня домена. На боевом домене
 * тег не выводится и индексация открыта.
 */
const IS_PREVIEW = (Astro.site?.host ?? '').endsWith('github.io');

/** Общая картинка сайта — для микроразметки организации и страниц без своей. */
const ogDefault = new URL(link('/img/og.jpg'), Astro.site).href;

/**
 * Картинка для соцсетей — своя у каждого раздела и языка:
 * public/img/og/<раздел>-<язык>.jpg, собирается `npm run og`
 * (scripts/og-images.mjs). Вложенные страницы берут картинку раздела,
 * остальные (политика, 404) — общую og.jpg.
 */
const OG_SECTIONS = ['exhibitions', 'production', 'prices', 'works', 'technologies', 'contacts', 'configurator'];
const ogSection = isHome ? 'home' : OG_SECTIONS.find((s) => path === `/${s}` || path.startsWith(`/${s}/`));
const ogImage = ogSection ? new URL(link(`/img/og/${ogSection}-${lang}.jpg`), Astro.site).href : ogDefault;

/**
 * Шрифты лежат в public/fonts с постоянными именами (scripts/fonts.py):
 * так их можно предзагрузить и кешировать навсегда (public/_headers).
 *
 * Montserrat Variable — те же файлы и диапазоны, что у @fontsource-variable/montserrat
 * (без вьетнамского). Латиница и основная кириллица предзагружаются: они нужны
 * на любой странице, расширенные наборы скачиваются, только если встретится такой символ.
 *
 * Caveat 600 — только буквы рукописных слов («под ключ», «turnkey», «работаем»,
 * «work»), с контекстными вариантами букв (calt). Нужен только на главной —
 * там и предзагружается.
 */
const fontUrl = (f: string) => link(`/fonts/${f}`);
const MONTSERRAT: [string, string][] = [
  ['montserrat-cyrillic-ext-wght-normal.woff2', 'U+0460-052F,U+1C80-1C8A,U+20B4,U+2DE0-2DFF,U+A640-A69F,U+FE2E-FE2F'],
  ['montserrat-cyrillic-wght-normal.woff2', 'U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116'],
  ['montserrat-latin-ext-wght-normal.woff2', 'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF'],
  ['montserrat-latin-wght-normal.woff2', 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD'],
];
const PRELOAD = ['montserrat-latin-wght-normal.woff2', 'montserrat-cyrillic-wght-normal.woff2', ...(isHome ? ['caveat-600-subset.woff2'] : [])];

/**
 * Запасной шрифт, пока Montserrat грузится: Arial, подогнанный по ширине и высоте
 * строки под Montserrat, — при подмене текст не переносится иначе и блоки не прыгают.
 * Семейство названо «Montserrat»: это второе имя в стеке body (global.css) и в стеке
 * холстов 3D-стенда, поэтому браузер берёт его сразу после 'Montserrat Variable'.
 * Цифры — из scripts/fonts.py: ширина русского и английского текста Montserrat 400/800
 * к Arial / Arial Bold ≈ 112,8 %. В браузере русский текст при этом выходил на 1 % шире,
 * поэтому взято 111,6 % — запасной шрифт не переносит строки раньше настоящего.
 * Высота строки — typo-метрики Montserrat 968/251 из 1000, делённые на size-adjust.
 * Liberation Sans — метрический двойник Arial в Linux.
 */
const fallbackFace = (weight: string, names: string[]) =>
  `@font-face{font-family:'Montserrat';font-style:normal;font-weight:${weight};src:${names.map((n) => `local('${n}')`).join(',')};size-adjust:111.6%;ascent-override:86.75%;descent-override:22.5%;line-gap-override:0%}`;

const fontFaces = [
  ...MONTSERRAT.map(
    ([f, range]) =>
      `@font-face{font-family:'Montserrat Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${fontUrl(f)}) format('woff2-variations');unicode-range:${range}}`,
  ),
  fallbackFace('100 599', ['Arial', 'ArialMT', 'Liberation Sans', 'LiberationSans']),
  fallbackFace('600 900', ['Arial Bold', 'Arial-BoldMT', 'Liberation Sans Bold', 'LiberationSans-Bold']),
  `@font-face{font-family:'Caveat';font-style:normal;font-weight:600;font-display:swap;src:url(${fontUrl('caveat-600-subset.woff2')}) format('woff2')}`,
].join('');

/**
 * Микроразметка. Организация описывается одинаково на всех страницах:
 * url — главная сайта, а не текущая страница. Юр. реквизиты добавятся,
 * когда заказчик их пришлёт.
 */
const homeUrl = new URL(link('/'), Astro.site).href;
const orgId = `${homeUrl}#organization`;

/** «Dubai Design District, Building 3, Floor 3, Dubai, UAE» → улица без города и страны. */
const streetAddress = local('en').address.split(',').slice(0, -2).join(',').trim();

/** «Ежедневно, 9:00–20:00» → «Mo-Su 09:00-20:00». Непонятный формат — не выводим. */
const openingHours = (() => {
  const m = local('ru').hours.match(/(\d{1,2}):(\d{2})\s*[–-]\s*(\d{1,2}):(\d{2})/);
  if (!m || !/ежедневно/i.test(local('ru').hours)) return undefined;
  const hh = (h: string) => h.padStart(2, '0');
  return `Mo-Su ${hh(m[1]!)}:${m[2]}-${hh(m[3]!)}:${m[4]}`;
})();

const orgLd = {
  '@type': ['LocalBusiness', 'ProfessionalService'],
  '@id': orgId,
  name: SITE_NAME,
  url: homeUrl,
  logo: new URL(link('/img/logo.png'), Astro.site).href,
  image: ogDefault,
  description: L.siteDescription,
  telephone: CONTACTS.phone,
  email: CONTACTS.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress,
    addressLocality: 'Dubai',
    addressCountry: 'AE',
  },
  ...(openingHours ? { openingHours } : {}),
  areaServed: L.exhibitionsArea.split(',').map((a) => ({ '@type': 'City', name: a.trim() })),
  sameAs: [CONTACTS.instagram],
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: CONTACTS.phone,
    email: CONTACTS.email,
    contactType: 'sales',
    availableLanguage: ['ru', 'en'],
  },
};

/** Хлебные крошки — на всех страницах, кроме главной и 404. */
const crumbList: Crumb[] = crumbs ?? (title ? [{ label: title }] : []);
const breadcrumbLd =
  !isHome && !is404 && crumbList.length > 0
    ? {
        '@type': 'BreadcrumbList',
        itemListElement: [{ href: '/', label: ui(lang).home }, ...crumbList].map((c, i, all) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: c.label,
          item: i === all.length - 1 ? abs(lang) : absPath(c.href ?? '/'),
        })),
      }
    : null;

/** Вопросы с главной — те же, что выводятся в блоке «Частые вопросы». */
const faqLd = isHome
  ? {
      '@type': 'FAQPage',
      mainEntity: faq(lang).map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;

const ld = {
  '@context': 'https://schema.org',
  '@graph': [orgLd, breadcrumbLd, faqLd].filter(Boolean),
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Анимации включаются, только если скрипт движения реально запустился.
      document.documentElement.classList.add('js-motion');
      setTimeout(function () { if (!window.__motionReady) document.documentElement.classList.remove('js-motion'); }, 2500);
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {PRELOAD.map((f) => <link rel="preload" href={fontUrl(f)} as="font" type="font/woff2" crossorigin />)}
    <style is:inline set:html={fontFaces} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={abs(lang)} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={abs(l)} />)}
    <link rel="alternate" hreflang="x-default" href={abs(DEFAULT_LANG)} />
    {IS_PREVIEW && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={link('/favicon.png')} type="image/png" />
    <link rel="apple-touch-icon" href={link('/img/icon-180.png')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={abs(lang)} />
    <meta property="og:locale" content={lang === 'en' ? 'en_AE' : 'ru_RU'} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={fullTitle} />
    <meta name="theme-color" content="#0F100D" />
    <script type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="skip" href="#main">{ui(lang).skip}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '@/scripts/motion';
    </script>
  </body>
</html>
