# Заголовки ответов для Cloudflare Pages (боевой домен).
# На GitHub Pages файл просто лежит статикой и ни на что не влияет.
# Ответы Pages Functions (functions/api/*) эти правила не получают.

# Безопасность — для всех страниц и файлов.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Сборка Astro: в именах файлов хеш содержимого — кешируем навсегда.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Картинки без хеша в имени — месяц.
/img/*
  Cache-Control: public, max-age=2592000
